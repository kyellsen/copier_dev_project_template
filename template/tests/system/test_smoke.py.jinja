"""Smoke test of the system tier — here so the tier is never empty.

Same reason as `tests/integration/test_smoke.py`: `just test-system` and
`just test-all` run `pytest tests/system`, and a missing directory is a pytest
usage error (exit 4) that no `|| test $? -eq 5` catches.

Replace this with the real end-to-end run. Do not delete it until there is one.
"""

from __future__ import annotations

import subprocess
import sys

import pytest


@pytest.mark.system
def test_a_fresh_interpreter_can_import_the_package() -> None:
    """The end-to-end minimum: the install works outside this test process.

    Importing in-process proves the source tree; a subprocess proves the
    install, which is what every system test runs through.
    """
    result = subprocess.run(
        [sys.executable, "-c", "import {{ python_module_name }} as p; print(p.__version__)"],
        capture_output=True,
        text=True,
        check=False,
    )

    assert result.returncode == 0, result.stderr
    assert result.stdout.strip()
