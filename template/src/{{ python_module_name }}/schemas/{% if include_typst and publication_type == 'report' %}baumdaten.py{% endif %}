"""Tree cadastre schema — mandatory fields per Massgaben D.1 (docs/gutachten/).

One row = one tree; a single-tree report is simply N = 1.
Validated by `just check-data` (Polars reader + row-wise pydantic validation).
"""

from pydantic import BaseModel, Field


class Baum(BaseModel):
    """One tree record from publication/tables/baumdaten.csv."""

    # Object identity (D.1)
    nummer: int = Field(ge=1, description="Tree number / cadastre reference")
    art_deutsch: str = Field(min_length=1, description="German species name")
    art_wiss: str = Field(min_length=1, description="Scientific species name")
    standort: str = Field(min_length=1, description="Address / site")
    koordinaten: str = Field(min_length=1, description="Coordinates")
    bezugssystem: str = Field(min_length=1, description="Coordinate reference system, e.g. WGS84")
    flurstueck: str = Field(min_length=1, description="Cadastral parcel")
    eigentuemer: str = Field(min_length=1, description="Owner / duty holder")

    # Tree data (D.1)
    stammumfang_cm: float = Field(gt=0, description="Trunk circumference in cm")
    messhoehe_m: float = Field(gt=0, le=2.0, description="Measurement height in m (standard 1.00)")
    hoehe_m: float = Field(gt=0, description="Tree height in m")
    kronendurchmesser_m: float = Field(gt=0, description="Crown diameter in m")
    kronenansatz_m: float = Field(ge=0, description="Crown base height in m")
    entwicklungsphase: str = Field(min_length=1, description="Development phase (FLL)")
    vitalitaet: str = Field(min_length=1, description="Vitality class")
    vitalitaet_skala: str = Field(min_length=1, description="Vitality scale used, e.g. Roloff")
