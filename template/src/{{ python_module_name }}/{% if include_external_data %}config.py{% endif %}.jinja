import os
from pathlib import Path
from dotenv import load_dotenv

# Project Root (three levels up: src / module / config.py → root)
PROJECT_ROOT = Path(__file__).resolve().parents[2]

# Load variables from .env if present (Nextcloud data paths{% if workspace_location_external %}, WORKSPACE_ROOT{% endif %})
load_dotenv(PROJECT_ROOT / ".env")

{% if not workspace_location_external %}
# Workspace: fixed relative path inside repo, gitignored.
# No configuration needed — always at PROJECT_ROOT/_workspace/
WORKSPACE = PROJECT_ROOT / "_workspace"
{% else %}
# Workspace: external directory configured via WORKSPACE_ROOT in .env
_workspace_root = os.environ.get("WORKSPACE_ROOT")
if not _workspace_root:
    raise ValueError(
        "WORKSPACE_ROOT is not set. "
        "Please copy .env.example to .env and fill in the path."
    )
WORKSPACE = Path(_workspace_root)
{% endif %}

# Ensure workspace exists
WORKSPACE.mkdir(parents=True, exist_ok=True)

# Output directories (figures, tables) — used by plot scripts and Typst
OUTPUT_DIR = WORKSPACE / "output"
FIGURES_DIR = OUTPUT_DIR / "figures"
TABLES_DIR = OUTPUT_DIR / "tables"
