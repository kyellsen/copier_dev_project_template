[project]
name = "{{ project_name }}"
version = "0.1.0"
description = "{{ description }}"
authors = [
    { name = "{{ author }}", email = "{{ author_email }}" }
]
requires-python = ">={{ python_version }}"
dependencies = [
    "python-dotenv>=1.0",
    "pydantic>=2.0",
    "polars>=1.5",  # Dataframe default — pandas only when a library forces it
{% if include_typst %}    "Pillow>=10.0",  # For downsampling high-resolution publication assets
    # Exposure fusion in the asset pipeline. Headless because the machines that
    # run it have no display, and the GUI build drags in X11 for nothing.
    "opencv-python-headless>=4.10",
    "numpy>=1.26",
{% endif %}    # Uncomment further data science dependencies as needed:
{% if not include_typst %}    # "numpy>=1.26",
{% endif %}    # "matplotlib>=3.9",
    # "scipy>=1.13",
    # "seaborn>=0.13",
    # "pyarrow>=15.0",
    # "duckdb>=1.0",
    # "scikit-learn>=1.4",
    # "sqlalchemy>=2.0",
    # "tqdm>=4.66",
    # GeoPython (GIS):
    # "geopandas>=1.0",
    # "shapely>=2.0",
    # "pyogrio>=0.10",
]

[dependency-groups]
dev = [
    # Pinned to a minor range on purpose: `ruff format` output changes between
    # minor releases, and this template ships pre-formatted files. An open upper
    # bound would turn every generated project red on the next ruff release.
    "ruff>=0.16,<0.17",
    "mypy>=1.14",
    "pytest>=8.0",
    "jupyterlab>=4.3",
    "ipykernel>=6.29",
]

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.ruff]
line-length = 100
target-version = "py{{ python_version | replace('.', '') }}"
src = ["src", "tests", "scripts"]
# ruff formats Python code blocks inside Markdown. AGENTS.canon.md is generated
# and hash-gated by the Canon Integrity stage, so it must never be reformatted —
# the two gates would contradict each other and no edit could satisfy both.
extend-exclude = ["AGENTS.canon.md"]

[tool.ruff.lint]
select = ["E", "F", "I", "UP", "B", "SIM", "C4", "PTH", "RUF"]
ignore = ["E501"]

[tool.ruff.lint.per-file-ignores]
"tests/**" = ["S101"]

[tool.mypy]
python_version = "{{ python_version }}"
ignore_missing_imports = true

[tool.pytest.ini_options]
minversion = "8.0"
testpaths = ["tests"]
python_files = ["test_*.py"]
addopts = "-v --import-mode=importlib"
markers = [
    "unit: Fast, isolated tests without I/O or external dependencies.",
    "integration: Tests that interact with filesystem, databases, or external data.",
    "system: Full pipeline end-to-end tests.",
]
