[project]
name = "{{ project_name }}"
version = "0.1.0"
description = "{{ description }}"
authors = [
    { name = "{{ author }}", email = "{{ author_email }}" }
]
requires-python = ">=3.13"
dependencies = [
    "python-dotenv>=1.0",
    # Uncomment data science dependencies as needed:
    # "pandas>=2.2",
    # "polars>=1.5",
    # "numpy>=1.26",
    # "matplotlib>=3.9",
    # "scipy>=1.13",
    # "seaborn>=0.13",
    # "pyarrow>=15.0",
    # "duckdb>=1.0",
    # "scikit-learn>=1.4",
    # "sqlalchemy>=2.0",
    # "tqdm>=4.66",
]

[dependency-groups]
dev = [
    "ruff>=0.4",
    "mypy>=1.10",
    "pytest>=8.0",
    "jupyterlab>=4.0",
    "ipykernel>=6.29",
]

[tool.ruff]
line-length = 100
target-version = "py313"

[tool.mypy]
strict = true
python_version = "3.13"
ignore_missing_imports = true
