[project]
name = "{{ project_name }}"
version = "0.1.0"
description = "{{ description }}"
authors = [
    { name = "{{ author }}", email = "{{ author_email }}" }
]
requires-python = ">={{ python_version }}"
dependencies = [
    "python-dotenv>=1.0",
    "pydantic>=2.0",
    "polars>=1.5",  # Dataframe default — pandas only when a library forces it
{% if include_typst %}    "Pillow>=10.0",  # For downsampling high-resolution publication assets
{% endif %}    # Uncomment further data science dependencies as needed:
    # "numpy>=1.26",
    # "matplotlib>=3.9",
    # "scipy>=1.13",
    # "seaborn>=0.13",
    # "pyarrow>=15.0",
    # "duckdb>=1.0",
    # "scikit-learn>=1.4",
    # "sqlalchemy>=2.0",
    # "tqdm>=4.66",
    # GeoPython (GIS):
    # "geopandas>=1.0",
    # "shapely>=2.0",
    # "pyogrio>=0.10",
]

[dependency-groups]
dev = [
    "ruff>=0.9",
    "mypy>=1.14",
    "pytest>=8.0",
    "jupyterlab>=4.3",
    "ipykernel>=6.29",
{% if include_precommit %}    "pre-commit>=4.0",
{% endif %}]

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.ruff]
line-length = 100
target-version = "py{{ python_version | replace('.', '') }}"
src = ["src", "tests", "scripts"]

[tool.ruff.lint]
select = ["E", "F", "I", "UP", "B", "SIM", "C4", "PTH", "RUF"]
ignore = ["E501"]

[tool.ruff.lint.per-file-ignores]
"tests/**" = ["S101"]

[tool.mypy]
python_version = "{{ python_version }}"
ignore_missing_imports = true

[tool.pytest.ini_options]
minversion = "8.0"
testpaths = ["tests"]
python_files = ["test_*.py"]
addopts = "-v --import-mode=importlib"
markers = [
    "unit: Fast, isolated tests without I/O or external dependencies.",
    "integration: Tests that interact with filesystem, databases, or external data.",
    "system: Full pipeline end-to-end tests.",
]
