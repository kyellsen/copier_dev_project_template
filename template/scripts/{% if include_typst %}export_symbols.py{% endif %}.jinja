"""Export used ColumnDef symbols to a Typst table for the Formelzeichenverzeichnis.

Reads all column/symbol definitions from `{{ python_module_name }}.schemas`,
filters to only those symbols actually used in math blocks ($...$) in the thesis/report text,
validates consistency, and generates a publication-ready Typst table at
`publication/tables/symbols.typ`.

Called by: `just symbols`
"""

from __future__ import annotations

import importlib
import pkgutil
import re
import sys
from pathlib import Path

import {{ python_module_name }} as pkg
from {{ python_module_name }}.schemas.columns import ColumnDef

from common import PROJECT_ROOT

PUB_TABLES_DIR = PROJECT_ROOT / "publication" / "tables"
CHAPTERS_DIR = PROJECT_ROOT / "publication" / "chapters"


def _discover_column_groups() -> list[tuple[ColumnDef, ...]]:
    """Auto-discover all column groups from schema modules."""
    groups: list[tuple[ColumnDef, ...]] = []

    try:
        for module_info in pkgutil.walk_packages(pkg.__path__, pkg.__name__ + "."):
            if "schema" in module_info.name:
                mod = importlib.import_module(module_info.name)
                for attr_name in dir(mod):
                    if attr_name.endswith("_COLUMNS") or attr_name.endswith("_SYMBOLS"):
                        val = getattr(mod, attr_name)
                        if isinstance(val, (list, tuple)) and val and isinstance(val[0], ColumnDef):
                            groups.append(tuple(val))
    except Exception as e:
        print(f"  ⚠ Schema discovery warning: {e}", file=sys.stderr)

    return groups


def _escape_typst(text: str) -> str:
    """Escape special characters for Typst."""
    if not isinstance(text, str):
        return str(text)
    return text.replace("_", "\\_")


def _collect_unique_symbols(
    column_groups: list[tuple[ColumnDef, ...]],
) -> list[ColumnDef]:
    """Deduplicate columns by symbol and context, keeping first occurrence."""
    seen: dict[tuple[str, str], ColumnDef] = {}
    for group in column_groups:
        for col in group:
            key = (col.symbol, col.context)
            if col.symbol and col.symbol != "—" and key not in seen:
                seen[key] = col
    return sorted(
        seen.values(),
        key=lambda c: (c.context, c.symbol.replace('"', "").replace("_", "").lower()),
    )


def _validate(
    column_groups: list[tuple[ColumnDef, ...]],
    unique: list[ColumnDef],
) -> bool:
    """Validate symbol consistency before export."""
    ok = True

    # 1. Duplicate symbol with conflicting units in the SAME context
    by_symbol_ctx: dict[tuple[str, str], list[ColumnDef]] = {}
    for group in column_groups:
        for col in group:
            if col.symbol and col.symbol != "—":
                by_symbol_ctx.setdefault((col.symbol, col.context), []).append(col)

    for (sym, ctx), cols in sorted(by_symbol_ctx.items()):
        units = {c.unit for c in cols}
        if len(units) > 1:
            detail = ", ".join(f"{c.name}={c.unit}" for c in cols)
            print(
                f"  ✗ UNIT CONFLICT: Symbol '{sym}' (ctx: {ctx}) has multiple units: {detail}",
                file=sys.stderr,
            )
            ok = False

    # 2. ISO 80000 notation check (descriptive subscript should use _"...")
    for col in unique:
        if re.search(r'_[A-Z](?![a-z"])', col.symbol):
            print(
                f"  ⚠ ISO 80000: '{col.symbol}' ({col.name}) — "
                f'beschreibender Index sollte _"..." sein',
                file=sys.stderr,
            )

    return ok


def _render_typst_table(columns: list[ColumnDef]) -> str:
    """Render a list of ColumnDefs as a Typst booktabs table, grouped by context."""
    from collections import defaultdict

    grouped = defaultdict(list)
    for col in columns:
        ctx = col.context if col.context else "general"
        grouped[ctx].append(col)

    lines = [
        "// Generated by scripts/export_symbols.py — DO NOT EDIT MANUALLY",
        "#table(",
        "  stroke: none,",
        "  columns: (auto, auto, auto, 1fr),",
        "  align: (center, left, left, left),",
        "  table.hline(stroke: 1pt),",
        "  table.header(",
        "    [*Symbol*], [*Bezeichnung*], [*Einheit*], [*Beschreibung*],",
        "  ),",
    ]

    for ctx in sorted(grouped.keys()):
        ctx_title = ctx.replace("_", " ").title()
        lines.append("  table.hline(stroke: 0.5pt),")
        lines.append(f"  table.cell(colspan: 4, align: center)[*--- {ctx_title} ---*],")
        lines.append("  table.hline(stroke: 0.5pt),")

        for col in grouped[ctx]:
            symbol = f"${col.symbol}$"
            label = _escape_typst(col.labels.get("de", col.labels.get("en", col.name)))
            unit = _escape_typst(col.unit) if col.unit != "datetime" else "—"
            desc = _escape_typst(col.descriptions.get("de", col.descriptions.get("en", "")))
            lines.append(f"  [{symbol}], [{label}], [{unit}], [{desc}],")

    lines.extend(["  table.hline(stroke: 1pt),", ")", ""])
    return "\n".join(lines)


def _read_chapter_text(chapters_dir: Path) -> str:
    """Read all chapter .typ files into a single string."""
    if not chapters_dir.exists():
        return ""
    return "\n".join(f.read_text(encoding="utf-8") for f in sorted(chapters_dir.rglob("*.typ")))


def _filter_used_symbols(
    symbols: list[ColumnDef],
    text: str,
) -> list[ColumnDef]:
    """Keep only symbols that appear in math blocks of the thesis/report text."""
    if not text.strip():
        return symbols

    used: list[ColumnDef] = []
    for col in symbols:
        escaped = re.escape(col.symbol)
        pattern = r"\$[^$]*(?<![a-zA-Z])" + escaped + r"(?![a-zA-Z])[^$]*\$"
        if re.search(pattern, text):
            used.append(col)

    return used


def main() -> None:
    groups = _discover_column_groups()
    if not groups:
        print(f"⚠️  No schema column groups found in {pkg.__name__}.schemas.")
        return

    unique = _collect_unique_symbols(groups)
    if not _validate(groups, unique):
        print("❌ Symbol validation failed.", file=sys.stderr)
        sys.exit(1)

    chapter_text = _read_chapter_text(CHAPTERS_DIR)
    used_symbols = _filter_used_symbols(unique, chapter_text)

    PUB_TABLES_DIR.mkdir(parents=True, exist_ok=True)
    out_file = PUB_TABLES_DIR / "symbols.typ"
    table_content = _render_typst_table(used_symbols)
    out_file.write_text(table_content, encoding="utf-8")
    print(f"✅ Exported {len(used_symbols)} symbols to {out_file.relative_to(PROJECT_ROOT)}")


if __name__ == "__main__":
    main()
