"""Verkleinert und kopiert große Rohbilder für die Publikation.

Dieser Schritt nimmt große Bilder (z.B. von einer Nikon Z6) aus dem externen 
Datenverzeichnis, skaliert sie für den PDF-Druck auf eine vernünftige Größe 
(z.B. max 1500px Breite) herunter und speichert sie im Workspace.
Von dort werden sie mit `just freeze` nach `publication/assets/` kopiert.
"""
import os
from pathlib import Path
from PIL import Image

PROJECT_ROOT = Path(__file__).resolve().parents[1]
WORKSPACE_ASSETS = PROJECT_ROOT / "_workspace" / "output" / "assets"

# TODO: Passe diesen Pfad an dein spezifisches Projekt an (z.B. via .env)
# Beispiel:
# RAW_IMAGES_DIR = Path(os.environ.get("{{ python_module_name | upper }}_DATA_ROOT", "/mnt/data/kyellsen/300_Projekte/...")) / "data" / "raw" / "photos"
RAW_IMAGES_DIR = PROJECT_ROOT / "data" / "raw" / "photos"  # Platzhalter

MAX_SIZE = (1500, 1500)
QUALITY = 85

def process_image(src_path: Path, dest_dir: Path):
    """Skaliert ein Bild und speichert es komprimiert ab."""
    dest_path = dest_dir / f"{src_path.stem}.jpg"
    
    # Überspringen, falls schon existiert (und neuer ist als Quelle)
    if dest_path.exists() and dest_path.stat().st_mtime >= src_path.stat().st_mtime:
        print(f"⏭  {dest_path.name} ist aktuell — übersprungen")
        return

    try:
        with Image.open(src_path) as img:
            # Konvertiere zu RGB falls nötig (z.B. bei RGBA/PNGs)
            if img.mode in ("RGBA", "P"):
                img = img.convert("RGB")
            
            # thumbnail behält das Seitenverhältnis bei!
            img.thumbnail(MAX_SIZE, Image.Resampling.LANCZOS)
            
            img.save(dest_path, "JPEG", quality=QUALITY, optimize=True)
            
            # Größe vergleichen für Ausgabe
            src_mb = src_path.stat().st_size / (1024 * 1024)
            dst_mb = dest_path.stat().st_size / (1024 * 1024)
            print(f"✓ {src_path.name}: {src_mb:.1f}MB -> {dst_mb:.2f}MB")
            
    except Exception as e:
        print(f"✗ Fehler bei {src_path.name}: {e}")

def main():
    if not RAW_IMAGES_DIR.exists():
        print(f"ℹ️ Quellverzeichnis existiert nicht: {RAW_IMAGES_DIR}")
        print("  Bitte Pfad in scripts/prepare_assets.py anpassen!")
        return

    WORKSPACE_ASSETS.mkdir(parents=True, exist_ok=True)
    
    image_files = list(RAW_IMAGES_DIR.glob("*.[jJ][pP][gG]")) + list(RAW_IMAGES_DIR.glob("*.[pP][nN][gG]"))
    
    if not image_files:
        print(f"ℹ️ Keine Bilder gefunden in {RAW_IMAGES_DIR}")
        return
        
    print(f"Verarbeite {len(image_files)} Bilder...")
    for img_path in image_files:
        process_image(img_path, WORKSPACE_ASSETS)
        
    print("\n✓ Assets vorbereitet. Run 'just freeze' um sie in publication/assets/ zu sichern.")

if __name__ == "__main__":
    main()
