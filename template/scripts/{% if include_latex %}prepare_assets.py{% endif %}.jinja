"""Resizes and copies large raw images for publication.

This step takes large images from the external data directory, 
downscales them to a reasonable size for PDF printing (e.g. max 1500px width), 
and saves them in the workspace.
From there, they are copied to `publication/assets/` via `just freeze`.
"""
import os
import json
import hashlib
from pathlib import Path
from PIL import Image, ImageOps
from dotenv import load_dotenv

PROJECT_ROOT = Path(__file__).resolve().parents[1]
WORKSPACE_ASSETS = PROJECT_ROOT / "_workspace" / "output" / "assets"
HASH_FILE = WORKSPACE_ASSETS / ".asset_hashes.json"

# Load environment variables from .env
load_dotenv(PROJECT_ROOT / ".env")

# Read path from .env
env_var_name = "{{ python_module_name | upper }}_RAW_ASSETS_DIR"
raw_dir_str = os.environ.get(env_var_name)
RAW_IMAGES_DIR = Path(raw_dir_str) if raw_dir_str else None

MAX_SIZE = (1500, 1500)
QUALITY = 85

def get_file_hash(filepath: Path) -> str:
    """Calculates a BLAKE2b hash of the file."""
    hasher = hashlib.blake2b(digest_size=16)
    with open(filepath, 'rb') as f:
        buf = f.read(65536)
        while len(buf) > 0:
            hasher.update(buf)
            buf = f.read(65536)
    return hasher.hexdigest()

def process_image(src_path: Path, dest_dir: Path, hashes: dict[str, str]) -> bool:
    """Scales an image, checks hashes, and saves it compressed.
    Returns True if processed, False if cached or failed."""
    dest_path = dest_dir / f"{src_path.stem}.jpg"
    
    current_hash = get_file_hash(src_path)
    file_key = src_path.name
    
    # Skip if file already exists and hash is unchanged
    if dest_path.exists() and hashes.get(file_key) == current_hash:
        print(f"⏭  {dest_path.name} is up-to-date (hash match) — skipped")
        return False

    try:
        with Image.open(src_path) as img:
            # Apply EXIF orientation (crucial for photos)
            img = ImageOps.exif_transpose(img)
            
            # Convert to RGB if necessary (e.g. for RGBA/PNGs)
            if img.mode in ("RGBA", "P"):
                img = img.convert("RGB")
            
            # thumbnail preserves aspect ratio
            img.thumbnail(MAX_SIZE, Image.Resampling.LANCZOS)
            
            img.save(dest_path, "JPEG", quality=QUALITY, optimize=True)
            
            # Save hash
            hashes[file_key] = current_hash
            
            # Compare size for output
            src_mb = src_path.stat().st_size / (1024 * 1024)
            dst_mb = dest_path.stat().st_size / (1024 * 1024)
            print(f"✓ {src_path.name}: {src_mb:.1f}MB -> {dst_mb:.2f}MB")
            return True
            
    except Exception as e:
        print(f"✗ Error processing {src_path.name}: {e}")
        return False

def main() -> None:
    if not RAW_IMAGES_DIR or not RAW_IMAGES_DIR.exists():
        print(f"ℹ️ Source directory for assets does not exist or is not configured.")
        print(f"  Please set {env_var_name} in your .env file!")
        if RAW_IMAGES_DIR:
            print(f"  Current value: {RAW_IMAGES_DIR}")
        return

    WORKSPACE_ASSETS.mkdir(parents=True, exist_ok=True)
    
    # Load hashes
    hashes: dict[str, str] = {}
    if HASH_FILE.exists():
        try:
            with open(HASH_FILE, "r") as f:
                hashes = json.load(f)
        except json.JSONDecodeError:
            pass
    
    # Find all standard image formats
    image_files = []
    for ext in ("*.[jJ][pP][gG]", "*.[jJ][pP][eE][gG]", "*.[pP][nN][gG]", "*.[wW][eE][bB][pP]", "*.[tT][iI][fF]*"):
        image_files.extend(RAW_IMAGES_DIR.glob(ext))
    
    if not image_files:
        print(f"ℹ️ No images (jpg, png, webp, tiff) found in {RAW_IMAGES_DIR}")
        return
        
    print(f"Processing {len(image_files)} images...")
    processed_count = 0
    for img_path in image_files:
        if process_image(img_path, WORKSPACE_ASSETS, hashes):
            processed_count += 1
            
    # Save hashes
    with open(HASH_FILE, "w") as f:
        json.dump(hashes, f, indent=2)
        
    if processed_count > 0:
        print(f"\n✓ Rescaled {processed_count} assets. Run 'just freeze' to back them up to publication/assets/.")
    else:
        print("\n✓ All assets are already up-to-date.")

if __name__ == "__main__":
    main()
