"""Builds a compressed photo cache from the RAW_ASSETS_DIR.

Reads JPG/JPEG/PNG/WEBP images and NEF (Nikon RAW) files from the configured
RAW_ASSETS_DIR, downscales them to publication quality, and writes the results
to _workspace/output/assets/, preserving the original subdirectory structure.

NEF files are decoded with automatic white balance and exposure correction
via `rawpy` (LibRaw) if installed. All outputs are JPEG, optimized for PDF embedding.

Underexposed photographs get a measured shadow lift -- see `plan_gamma`. Files
whose source has disappeared are pruned from the cache.

Fast change detection (mtime + size + settings) ensures idempotent runs -- only
new, changed or differently-configured source files are reprocessed.

Usage:
    python scripts/prepare_assets.py [--no-tone] [--force] [--dry-run]
"""

import argparse
import json
import math
import multiprocessing
import os
from concurrent.futures import ProcessPoolExecutor, as_completed
from pathlib import Path

from dotenv import load_dotenv
from PIL import Image, ImageOps

PROJECT_ROOT = Path(__file__).resolve().parents[1]
WORKSPACE_ASSETS = PROJECT_ROOT / "_workspace" / "output" / "assets"
HASH_FILE = WORKSPACE_ASSETS / ".asset_hashes.json"

# Load environment variables from .env
load_dotenv(PROJECT_ROOT / ".env")

# Read path from .env
env_var_name = "{{ python_module_name | upper }}_RAW_ASSETS_DIR"
raw_dir_str = os.environ.get(env_var_name)
RAW_IMAGES_DIR = Path(raw_dir_str) if raw_dir_str else None

# --- Configuration ---
MAX_SIZE = (1500, 1500)
QUALITY = 85

# Supported file suffixes (lowercase)
SUFFIXES_IMAGE = {".jpg", ".jpeg", ".png", ".webp", ".tif", ".tiff"}
SUFFIXES_RAW = {".nef"}
SUFFIXES_ALL = SUFFIXES_IMAGE | SUFFIXES_RAW

# --- Tone correction ---
# Three set numbers, and each one is arguable without knowing the subject:
# when shadows count as blocked, how much of that we accept afterwards, and how
# far a single correction may ever go. Everything else is measured per image.
SHADOW_LEVEL = 16  # at or below this, a pixel carries no drawing
HIGHLIGHT_LEVEL = 240  # at or above this, a pixel is effectively white
TONE_SHADOW_TRIGGER = 10.0  # % blocked shadow before anything happens at all
TONE_SHADOW_TARGET = 5.0  # % blocked shadow we aim to be left with
TONE_HIGHLIGHT_GROWTH = 1.5  # percentage points the near-white share may gain
TONE_HIGHLIGHT_CEILING = 20.0  # % near-white that is never exceeded, whatever
TONE_GAMMA_CAP = 2.0  # hard ceiling, whatever the measurement asks for
TONE_GAMMA_FLOOR = 1.05  # below this, not worth touching the file for


def get_file_meta(filepath: Path, tone: bool) -> dict[str, float | int | bool]:
    """Get mtime + size + settings for fast change detection (no file read).

    `tone` is part of the key on purpose: flipping --no-tone has to invalidate
    the cache, or the flag would silently do nothing on an already-built cache.
    """
    st = filepath.stat()
    return {"mtime": st.st_mtime, "size": st.st_size, "tone": tone}


def is_raw_file(filepath: Path) -> bool:
    """Check if a file is a RAW format that needs rawpy decoding."""
    return filepath.suffix.lower() in SUFFIXES_RAW


def _share_below(hist: list[int], level: int) -> float:
    total = sum(hist)
    return sum(hist[:level]) / total * 100 if total else 0.0


def _share_above(hist: list[int], level: int) -> float:
    total = sum(hist)
    return sum(hist[level:]) / total * 100 if total else 0.0


def _percentile_level(hist: list[int], pct: float) -> int:
    """Lowest grey level at or below which `pct` percent of the pixels sit."""
    total = sum(hist)
    if total == 0:
        return 0
    want = total * pct / 100
    seen = 0
    for level, count in enumerate(hist):
        seen += count
        if seen >= want:
            return level
    return 255


def _lowest_level_above_at_most(hist: list[int], share: float) -> int:
    """Lowest grey level from which upwards at most `share` percent sit."""
    total = sum(hist)
    if total == 0:
        return 255
    limit = total * share / 100
    seen = 0
    for level in range(255, -1, -1):
        seen += hist[level]
        if seen > limit:
            return level + 1
    return 0


def is_photograph(img: Image.Image) -> bool:
    """True for a camera image, False for anything drawn, plotted or exported.

    A map from QGIS, a matplotlib PNG and a screenshot have tone values that
    were designed rather than measured, so "correcting" them is always wrong --
    a dark chart background is a decision, not an underexposure. The camera tags
    are the only thing in the file that separates the two cases.
    """
    try:
        exif = img.getexif()
    except Exception:
        return False
    if not exif:
        return False
    if exif.get(0x010F) or exif.get(0x0110):  # Make, Model
        return True
    try:
        photo = exif.get_ifd(0x8769)  # Exif IFD
    except Exception:
        return False
    return any(photo.get(tag) for tag in (0x9003, 0x829A, 0x829D))


def apply_gamma(img: Image.Image, gamma: float) -> Image.Image:
    """Apply a gamma curve. Fixes 0 and 255, so it lifts without clipping."""
    if gamma <= 1.0:
        return img
    lut = [round(255 * (i / 255) ** (1 / gamma)) for i in range(256)]
    return img.point(lut * len(img.getbands()))


def plan_gamma(img: Image.Image) -> float:
    """The gamma this image needs, or 1.0 to leave it alone.

    Brightness is the wrong trigger: it measures the subject, not the exposure.
    A frame full of sky reads bright and a dark-themed screenshot reads dark,
    and neither wants touching. What underexposure actually looks like is a
    histogram jammed against the bottom while there is room left at the top, and
    that reads the same on a forest stand, an interior and a stem base.

    The shadow side asks for a lift, the highlight side caps what may be
    granted. Both come straight off the histogram: a gamma curve maps level t to
    255*(t/255)**(1/g), so the share ending up beyond a level is the share that
    started beyond that level's preimage.

    The highlight bound is a *growth* limit, not an absolute one. An absolute
    one disqualifies every photograph that merely contains sky -- in a forest
    stand, most of them, which is precisely the stock this exists for. Sky that
    was already blown stays blown either way; what must not happen is drawing
    being burnt away, so what gets bounded is how much white may be gained.
    """
    grey = img.convert("L")
    hist = grey.histogram()

    shadow = _share_below(hist, SHADOW_LEVEL)
    highlight = _share_above(hist, HIGHLIGHT_LEVEL)

    if shadow <= TONE_SHADOW_TRIGGER or highlight >= TONE_HIGHLIGHT_CEILING:
        return 1.0

    # How far to lift: the level that TONE_SHADOW_TARGET percent sit below has
    # to land on SHADOW_LEVEL.
    src = _percentile_level(hist, TONE_SHADOW_TARGET)
    if src <= 0 or src >= SHADOW_LEVEL:
        return 1.0
    g_shadow = math.log(src / 255) / math.log(SHADOW_LEVEL / 255)

    # How far the highlights allow.
    allowed = min(highlight + TONE_HIGHLIGHT_GROWTH, TONE_HIGHLIGHT_CEILING)
    top = _lowest_level_above_at_most(hist, allowed)
    g_high = (
        math.log(top / 255) / math.log(HIGHLIGHT_LEVEL / 255) if 0 < top < 255 else TONE_GAMMA_CAP
    )

    gamma = min(g_shadow, g_high, TONE_GAMMA_CAP)

    # Those bounds are exact on the luminance histogram, but the curve is applied
    # per channel and luminance is a weighted sum of them -- the two only agree
    # where the channels do, and on a blue sky they do not. Plus the 8-bit table
    # rounds. So verify the way the file will actually be written and back off.
    for _ in range(4):
        if gamma < TONE_GAMMA_FLOOR:
            return 1.0
        after = _share_above(apply_gamma(img, gamma).convert("L").histogram(), HIGHLIGHT_LEVEL)
        if after <= allowed:
            return gamma
        gamma -= 0.1

    return 1.0


def process_raw(src_path: Path, dest_path: Path) -> tuple[bool, float]:
    """Decode a RAW file with auto white balance and exposure correction.

    No shadow lift here: LibRaw already tone-maps off the sensor data, which is
    a better starting point than anything this can do to an 8-bit result.
    """
    try:
        import rawpy
    except ImportError:
        print(f"  ✗ rawpy not installed — cannot process {src_path.name}")
        return False, 1.0

    try:
        with rawpy.imread(str(src_path)) as raw:
            rgb = raw.postprocess(
                use_camera_wb=True,
                no_auto_bright=False,
                output_bps=8,
            )

        img = Image.fromarray(rgb)
        img.thumbnail(MAX_SIZE, Image.Resampling.LANCZOS)
        img.save(dest_path, "JPEG", quality=QUALITY, optimize=True)
        return True, 1.0

    except Exception as e:
        print(f"  ✗ RAW error {src_path.name}: {e}")
        return False, 1.0


def process_standard_image(src_path: Path, dest_path: Path, tone: bool) -> tuple[bool, float]:
    """Process a standard image (JPG/PNG): EXIF fix, downscale, tone, compress.

    Returns (success, applied_gamma). The gamma is reported and recorded rather
    than left implicit: a photograph in an expert report is evidence, so what
    was changed about it has to stay answerable. The untouched original stays in
    the external asset directory either way.

    The EXIF block is carried over deliberately. A capture date per photo is
    routinely required, and DateTimeOriginal is the only evidence for it that
    survives a rename -- dropping it here is what left one report's asset stock
    undatable. Orientation is stripped instead: exif_transpose has already
    applied it to the pixels, so keeping the tag would rotate the image twice.
    """
    try:
        with Image.open(src_path) as handle:
            exif = handle.getexif()
            exif.pop(0x0112, None)  # Orientation, already baked into the pixels
            photograph = is_photograph(handle)
            img: Image.Image = ImageOps.exif_transpose(handle) or handle
            if img.mode in ("RGBA", "P"):
                img = img.convert("RGB")
            img.thumbnail(MAX_SIZE, Image.Resampling.LANCZOS)

            # Measured after downscaling, so the histogram is the one that ends
            # up in the file, and the verification loop stays cheap.
            gamma = plan_gamma(img) if (tone and photograph) else 1.0
            if gamma > 1.0:
                img = apply_gamma(img, gamma)

            img.save(
                dest_path,
                "JPEG",
                quality=QUALITY,
                optimize=True,
                exif=exif.tobytes() if len(exif) else b"",
            )
        return True, gamma

    except Exception as e:
        print(f"  ✗ Error {src_path.name}: {e}")
        return False, 1.0


def process_image_task(
    src_path: Path,
    dest_path: Path,
    meta: dict[str, float | int | bool],
    file_key: str,
    tone: bool,
) -> tuple[bool, str, dict[str, float | int | bool] | None]:
    """Process a single image: convert/downscale/tone, save. Runs in a worker.

    Returns (success_flag, file_key, meta).
    """
    dest_path.parent.mkdir(parents=True, exist_ok=True)

    if is_raw_file(src_path):
        success, gamma = process_raw(src_path, dest_path)
    else:
        success, gamma = process_standard_image(src_path, dest_path, tone)

    if success:
        src_mb = float(meta["size"]) / (1024 * 1024)
        dst_kb = dest_path.stat().st_size / 1024
        fmt = "RAW" if is_raw_file(src_path) else "IMG"
        note = f", gamma {gamma:.2f}" if gamma > 1.0 else ""
        print(f"  ✓ [{fmt}] {src_path.name}: {src_mb:.1f} MB → {dst_kb:.0f} KB{note}")
        if gamma > 1.0:
            meta = {**meta, "gamma": round(gamma, 3)}
        return True, file_key, meta

    return False, file_key, None


def prune_cache(
    cache: dict[str, dict[str, float | int | bool]],
    live_keys: set[str],
    dry_run: bool,
) -> int:
    """Drop cached files and hash entries whose source no longer exists.

    Without this, renaming a source directory doubles the cache: the new names
    get built and the old ones stay behind forever, indistinguishable from
    current output. Only files this script produces are ever removed.
    """
    removed = 0

    for cached in sorted(WORKSPACE_ASSETS.rglob("*.jpg")):
        rel = cached.relative_to(WORKSPACE_ASSETS)
        if str(rel.with_suffix("")) in live_keys:
            continue
        print(f"  ✗ {rel} (source gone)")
        if not dry_run:
            cached.unlink()
        removed += 1

    for stale in [k for k in cache if str(Path(k).with_suffix("")) not in live_keys]:
        cache.pop(stale)

    if not dry_run:
        for d in sorted(WORKSPACE_ASSETS.rglob("*"), reverse=True):
            if d.is_dir() and not any(d.iterdir()):
                d.rmdir()

    return removed


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--no-tone",
        action="store_true",
        help="never lift shadows, copy the exposure through as it is",
    )
    parser.add_argument(
        "--force",
        action="store_true",
        help="ignore the cache and rebuild every file",
    )
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="report what would be built and pruned, write nothing",
    )
    args = parser.parse_args()
    tone = not args.no_tone

    # Fix rawpy/OpenMP deadlocks on Linux
    if multiprocessing.get_start_method(allow_none=True) != "spawn":
        multiprocessing.set_start_method("spawn", force=True)

    if not RAW_IMAGES_DIR or not RAW_IMAGES_DIR.exists():
        print("Info: Source directory for assets does not exist or is not configured.")
        print(f"  Please set {env_var_name} in your .env file!")
        if RAW_IMAGES_DIR:
            print(f"  Current value: {RAW_IMAGES_DIR}")
        return

    WORKSPACE_ASSETS.mkdir(parents=True, exist_ok=True)

    # Load hashes
    cache: dict[str, dict[str, float | int | bool]] = {}
    if HASH_FILE.exists():
        try:
            with HASH_FILE.open("r") as f:
                cache = json.load(f)
        except json.JSONDecodeError:
            pass

    # Find all supported image files recursively
    image_files = sorted(
        f for f in RAW_IMAGES_DIR.rglob("*") if f.is_file() and f.suffix.lower() in SUFFIXES_ALL
    )

    if not image_files:
        print(f"Info: No images found in {RAW_IMAGES_DIR}")
        return

    mode = []
    if not tone:
        mode.append("no tone correction")
    if args.force:
        mode.append("forced rebuild")
    if args.dry_run:
        mode.append("dry run")
    suffix = f"  [{', '.join(mode)}]" if mode else ""
    print(f"📷 Found {len(image_files)} images in {RAW_IMAGES_DIR}{suffix}")

    total_processed = 0
    tasks = []
    live_keys: set[str] = set()

    # Check cache sequentially (fast, avoids process overhead)
    for img_path in image_files:
        rel_path = img_path.relative_to(RAW_IMAGES_DIR)
        dest_path = WORKSPACE_ASSETS / rel_path.with_suffix(".jpg")
        file_key = str(rel_path)
        meta = get_file_meta(img_path, tone)
        live_keys.add(str(rel_path.with_suffix("")))

        cached = cache.get(file_key)
        if (
            not args.force
            and dest_path.exists()
            and cached
            and cached.get("mtime") == meta["mtime"]
            and cached.get("size") == meta["size"]
            and cached.get("tone", True) == tone
        ):
            continue  # Up-to-date

        tasks.append((img_path, dest_path, meta, file_key, tone))

    # Remove output whose source has disappeared (renamed or deleted directories)
    print("\n🧹 Pruning")
    removed = prune_cache(cache, live_keys, args.dry_run)
    print(f"  → {removed} orphaned file(s)" if removed else "  → nothing orphaned")

    if args.dry_run:
        print(f"\n✓ dry run: would build {len(tasks)}, would prune {removed}, nothing written")
        return

    # Process new/changed files in parallel using all CPU cores
    toned = 0
    if tasks:
        cores = multiprocessing.cpu_count()
        print(f"\n→ Processing {len(tasks)} files using {cores} CPU cores...")
        with ProcessPoolExecutor(max_workers=cores) as executor:
            futures = [executor.submit(process_image_task, *task) for task in tasks]
            for future in as_completed(futures):
                success, file_key, meta_result = future.result()
                if success and meta_result is not None:
                    total_processed += 1
                    toned += 1 if meta_result.get("gamma") else 0
                    cache[file_key] = meta_result

    total_skipped = len(image_files) - total_processed

    # Save hashes
    with HASH_FILE.open("w") as f:
        json.dump(cache, f, indent=2)

    print(f"\n✓ prepare-assets done: {total_processed} new/updated, {total_skipped} cached")
    if toned:
        print(f"  {toned} underexposed photo(s) got a shadow lift (gamma recorded per file)")
    if total_processed > 0:
        print("  Use 'just add-photo <path/to/file.jpg>' to add specific assets to publication.")


if __name__ == "__main__":
    main()
