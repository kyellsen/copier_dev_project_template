"""Checks that all environment variables and data paths are reachable. Called by: just check-env"""

import os
import sys
from pathlib import Path

from dotenv import load_dotenv

from common import PROJECT_ROOT

load_dotenv(PROJECT_ROOT / ".env")

# Path variables are recognised by their suffix, so a root added to .env.example
# is checked here without touching this file.
PATH_SUFFIXES = ("_ROOT", "_DIR")

# Roots that may legitimately be absent -- a private repository a fresh clone
# does not have, an optional dataset whose tests skip when it is unset. Listed
# here they are reported as a note instead of failing the check.
OPTIONAL: set[str] = set()


def declared_path_vars() -> list[str]:
    """Read the path variables declared in .env.example, in file order.

    .env.example is the declaration of what this project reads, so it is also
    the list of what to check. A missing one is fatal rather than a fallback to
    a hard-coded list: a list written twice is a list that drifts.
    """
    example = PROJECT_ROOT / ".env.example"
    if not example.exists():
        print(f"❌ {example.name} is missing — cannot tell which paths are expected")
        sys.exit(1)

    names = []
    for line in example.read_text(encoding="utf-8").splitlines():
        line = line.strip()
        if line.startswith("#") or "=" not in line:
            continue
        name = line.split("=", 1)[0].strip()
        if name.endswith(PATH_SUFFIXES):
            names.append(name)
    return names


def main() -> None:
    errors: list[str] = []
    notes: list[str] = []

    for var in declared_path_vars():
        val = os.environ.get(var)
        if val and Path(val).expanduser().resolve().is_dir():
            continue
        message = f"{var} not reachable or not a directory: {val or '<unset>'}"
        if var in OPTIONAL:
            notes.append(f"⚠️  {message} (optional)")
        else:
            errors.append(f"❌ {message}")

    if notes:
        print("\n".join(notes))

    if errors:
        print("\n".join(errors))
        sys.exit(1)

    print("✅ Environment OK — all data paths reachable")


if __name__ == "__main__":
    main()
