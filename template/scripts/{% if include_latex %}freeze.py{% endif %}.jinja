"""Kopiert Pipeline-Output nach publication/ für Git-Commit."""
import shutil
from pathlib import Path

PROJECT_ROOT = Path(__file__).resolve().parents[1]
SOURCE = PROJECT_ROOT / "_workspace" / "output"
PUB = PROJECT_ROOT / "publication"

for subdir in ["figures", "tables", "assets"]:
    dest = PUB / subdir
    src = SOURCE / subdir
    if src.exists():
        dest.mkdir(parents=True, exist_ok=True)
        shutil.copytree(src, dest, dirs_exist_ok=True)
        print(f"✓ {subdir}/ kopiert/aktualisiert")
    else:
        dest.mkdir(parents=True, exist_ok=True)
        print(f"⚠ {subdir}/ ist leer — leeres Verzeichnis erstellt")

print("✓ Plots/Tabellen eingefroren. Jetzt committen.")
