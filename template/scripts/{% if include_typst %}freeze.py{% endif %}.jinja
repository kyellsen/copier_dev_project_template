"""Syncs pipeline output and refreshes committed photos for git commit.

1. Smart-sync figures/ and tables/ from workspace output to publication/
   (add new, update changed, remove stale files).
2. Refresh already-committed photos in publication/assets/ from the
   compressed cache (update only, no add/delete).
3. Size warnings for files > WARN_SIZE_MB.
"""

import shutil
from pathlib import Path

from common import PROJECT_ROOT, {% if include_photo_pipeline %}asset_sources, {% endif %}workspace_root

SOURCE = workspace_root() / "output"
PUB = PROJECT_ROOT / "publication"

WARN_SIZE_MB = 2.0

# Full sync (add/update/delete) for pipeline outputs
SYNC_DIRS = ["figures", "tables"]


def smart_sync(src: Path, dest: Path) -> tuple[int, int, int]:
    """Sync src → dest with add/update/delete semantics.

    Returns (added, updated, removed) counts.
    """
    added, updated, removed = 0, 0, 0

    # 1. Copy new/changed files
    if src.exists():
        for f in sorted(src.rglob("*")):
            if f.is_file():
                rel = f.relative_to(src)
                target = dest / rel
                target.parent.mkdir(parents=True, exist_ok=True)

                if not target.exists():
                    shutil.copy2(f, target)
                    added += 1
                    print(f"  + {rel}")
                elif f.stat().st_mtime > target.stat().st_mtime:
                    shutil.copy2(f, target)
                    updated += 1
                    print(f"  ~ {rel}")

    # 2. Remove stale files (in dest but not in src)
    if dest.exists():
        for f in sorted(dest.rglob("*")):
            if f.is_file():
                rel = f.relative_to(dest)
                if not src.exists() or not (src / rel).exists():
                    f.unlink()
                    removed += 1
                    print(f"  ✗ {rel} (removed — not in source)")

        # Clean up empty directories
        for d in sorted(dest.rglob("*"), reverse=True):
            if d.is_dir() and not any(d.iterdir()):
                d.rmdir()

    return added, updated, removed


def refresh_photos(cache_dir: Path, pub_dir: Path) -> int:
    """Refresh already-committed photos from cache (update only, no add/delete).

    Walks publication/assets/ and updates any file that has a newer version
    in the workspace cache. Does NOT add new files or remove existing ones —
    that's the job of 'just add-photo'.

    Returns the number of updated files.
    """
    updated = 0

    if not pub_dir.exists():
        return 0

    for f in sorted(pub_dir.rglob("*")):
        if f.is_file():
            rel = f.relative_to(pub_dir)
            cached = cache_dir / rel
            if cached.exists() and cached.stat().st_mtime > f.stat().st_mtime:
                shutil.copy2(cached, f)
                updated += 1
                print(f"  ~ {rel}")

    return updated


def main() -> None:
    """Run smart-sync for pipeline outputs and refresh committed photos."""
    total_added, total_updated, total_removed = 0, 0, 0

    # 1. Smart-sync pipeline outputs (figures, tables)
    for subdir in SYNC_DIRS:
        src = SOURCE / subdir
        dest = PUB / subdir
        dest.mkdir(parents=True, exist_ok=True)

        if not src.exists() or not any(src.rglob("*")):
            print(f"⚠ {subdir}/ — source empty, skipped")
            continue

        print(f"\n🔄 {subdir}/")
        added, updated, removed = smart_sync(src, dest)
        total_added += added
        total_updated += updated
        total_removed += removed
        print(f"  → +{added} new, ~{updated} updated, -{removed} removed")

{% if include_photo_pipeline %}    # 2. Refresh committed photos from every image stock's cache. The toggles
    # are deliberately ignored here: a stock switched off for a faster build is
    # still committed to the document, and its photos stay current.
    for source in asset_sources():
        if not source.publication_dir.exists() or not source.cache_dir.exists():
            continue
        label = source.name or "assets"
        print(f"\n📷 {label} (refresh committed photos)")
        photo_updated = refresh_photos(source.cache_dir, source.publication_dir)
        total_updated += photo_updated
        if photo_updated > 0:
            print(f"  → ~{photo_updated} photos refreshed from cache")
        else:
            print("  → all photos up-to-date")

{% endif %}    # 3. Size warnings
    print()
    total_mb = 0.0
    warnings: list[str] = []
    for subdir in [*SYNC_DIRS, "assets"]:
        dest = PUB / subdir
        if not dest.exists():
            continue
        for f in dest.rglob("*"):
            if f.is_file():
                size_mb = f.stat().st_size / (1024 * 1024)
                total_mb += size_mb
                if size_mb > WARN_SIZE_MB:
                    rel = f.relative_to(PUB)
                    warnings.append(f"  ⚠ {rel}: {size_mb:.1f} MB")

    if warnings:
        print("Size warnings (> 2 MB):")
        for w in warnings:
            print(w)

    changes = total_added + total_updated + total_removed
    print(
        f"\n✓ Freeze done: +{total_added} new, ~{total_updated} updated, "
        f"-{total_removed} removed ({total_mb:.1f} MB total)"
    )

    if changes > 0:
        print("  Next: git add publication/ && git commit")
    else:
        print("  Nothing changed.")


if __name__ == "__main__":
    main()
