"""Copies pipeline output to publication/ for git commit."""
import shutil
from pathlib import Path

PROJECT_ROOT = Path(__file__).resolve().parents[1]
SOURCE = PROJECT_ROOT / "_workspace" / "output"
PUB = PROJECT_ROOT / "publication"

for subdir in ["figures", "tables", "assets"]:
    dest = PUB / subdir
    src = SOURCE / subdir
    if src.exists():
        dest.mkdir(parents=True, exist_ok=True)
        shutil.copytree(src, dest, dirs_exist_ok=True)
        print(f"✓ {subdir}/ copied/updated")
    else:
        dest.mkdir(parents=True, exist_ok=True)
        print(f"⚠ {subdir}/ is empty — created empty directory")

print("✓ Plots/Tables frozen. Ready to commit.")
