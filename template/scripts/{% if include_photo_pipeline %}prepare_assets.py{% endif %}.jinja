"""Builds a compressed photo cache from the RAW_ASSETS_DIR.

Reads JPG/JPEG/PNG/WEBP images and NEF (Nikon RAW) files from the configured
RAW_ASSETS_DIR, downscales them to publication quality, and writes the results
to _workspace/output/assets/, preserving the original subdirectory structure.

NEF files are decoded with automatic white balance and exposure correction
via `rawpy` (LibRaw) if installed. All outputs are JPEG, optimized for PDF embedding.

Photographs get an automatic exposure correction by exposure fusion -- see
`fuse_exposures`. Files whose source has disappeared are pruned from the cache.

Fast change detection (mtime + size + settings) ensures idempotent runs -- only
new, changed or differently-configured source files are reprocessed.

Usage:
    python scripts/prepare_assets.py [--no-tone] [--force] [--dry-run]
"""

import argparse
import json
import multiprocessing
import os
from concurrent.futures import ProcessPoolExecutor, as_completed
from pathlib import Path

import cv2
import numpy as np
from dotenv import load_dotenv
from PIL import Image, ImageOps

PROJECT_ROOT = Path(__file__).resolve().parents[1]
WORKSPACE_ASSETS = PROJECT_ROOT / "_workspace" / "output" / "assets"
HASH_FILE = WORKSPACE_ASSETS / ".asset_hashes.json"

# Load environment variables from .env
load_dotenv(PROJECT_ROOT / ".env")

# Read path from .env
env_var_name = "{{ python_module_name | upper }}_RAW_ASSETS_DIR"
raw_dir_str = os.environ.get(env_var_name)
RAW_IMAGES_DIR = Path(raw_dir_str) if raw_dir_str else None

# --- Configuration ---
MAX_SIZE = (1500, 1500)
QUALITY = 85

# Supported file suffixes (lowercase)
SUFFIXES_IMAGE = {".jpg", ".jpeg", ".png", ".webp", ".tif", ".tiff"}
SUFFIXES_RAW = {".nef"}
SUFFIXES_ALL = SUFFIXES_IMAGE | SUFFIXES_RAW

# --- Exposure correction ---
# The gamma values of the simulated exposure bracket. Below 1 brightens, above 1
# darkens; the fusion picks per pixel, so this is a range to choose from rather
# than a setting to get right. The dark end is what keeps a bright sky from
# washing out, the bright end is what opens a subject standing in front of it.
EXPOSURE_BRACKET = (1.6, 1.0, 0.45, 0.3)

# Written into the cache entry. Change it when the method changes and every
# cached file rebuilds by itself, because the stored tag no longer matches.
TONE_METHOD = "fusion"


def get_file_meta(filepath: Path, tone: str | bool) -> dict[str, float | int | str | bool]:
    """Get mtime + size + method for fast change detection (no file read).

    The method tag is part of the key on purpose: flipping --no-tone, or
    changing how correction works at all, has to invalidate the cache. Otherwise
    the flag silently does nothing on an already-built cache.
    """
    st = filepath.stat()
    return {"mtime": st.st_mtime, "size": st.st_size, "tone": tone}


def is_raw_file(filepath: Path) -> bool:
    """Check if a file is a RAW format that needs rawpy decoding."""
    return filepath.suffix.lower() in SUFFIXES_RAW


def is_photograph(img: Image.Image) -> bool:
    """True for a camera image, False for anything drawn, plotted or exported.

    A map from QGIS, a matplotlib PNG and a screenshot have tone values that
    were designed rather than captured, so "correcting" their exposure is
    meaningless -- a dark chart background is a decision, not an underexposure.
    The camera tags are the only thing in the file that separates the two.

    This is not an exposure rule with exceptions; it is the question of whether
    an exposure exists at all. Photographs are all treated identically.
    """
    try:
        exif = img.getexif()
    except Exception:
        return False
    if not exif:
        return False
    if exif.get(0x010F) or exif.get(0x0110):  # Make, Model
        return True
    try:
        photo = exif.get_ifd(0x8769)  # Exif IFD
    except Exception:
        return False
    return any(photo.get(tag) for tag in (0x9003, 0x829A, 0x829D))


def fuse_exposures(img: Image.Image) -> Image.Image:
    """Automatic exposure correction by exposure fusion (Mertens et al. 2007).

    A single frame cannot hold both a trunk in shade and the sky behind it, and
    no global curve can fix that -- brighten enough for the trunk and the sky
    goes, protect the sky and the trunk stays unreadable. Fusion sidesteps the
    trade: it derives a bracket of exposures from the one frame, then picks per
    *pixel* from whichever exposure is best there, weighted by contrast,
    saturation and well-exposedness. The trunk comes from a bright variant, the
    sky behind it from a dark one.

    This is the standard technique for the problem and the implementation is
    OpenCV's; the only local choice is which exposures to offer it. Every
    photograph gets the same treatment -- no threshold, no trigger, no branch.
    """
    base = np.asarray(img.convert("RGB")).astype(np.float32) / 255.0
    bracket = [
        (np.clip(base, 0.0, 1.0) ** gamma * 255).astype(np.uint8) for gamma in EXPOSURE_BRACKET
    ]
    fused = cv2.createMergeMertens().process(bracket)
    return Image.fromarray(np.clip(fused * 255, 0, 255).astype(np.uint8))


def process_raw(src_path: Path, dest_path: Path, tone: bool) -> bool:
    """Decode a RAW file with auto white balance and exposure correction."""
    try:
        import rawpy
    except ImportError:
        print(f"  ✗ rawpy not installed — cannot process {src_path.name}")
        return False

    try:
        with rawpy.imread(str(src_path)) as raw:
            rgb = raw.postprocess(
                use_camera_wb=True,
                no_auto_bright=False,
                output_bps=8,
            )

        img = Image.fromarray(rgb)
        img.thumbnail(MAX_SIZE, Image.Resampling.LANCZOS)
        if tone:
            img = fuse_exposures(img)
        img.save(dest_path, "JPEG", quality=QUALITY, optimize=True)
        return True

    except Exception as e:
        print(f"  ✗ RAW error {src_path.name}: {e}")
        return False


def process_standard_image(src_path: Path, dest_path: Path, tone: bool) -> tuple[bool, bool]:
    """Process a standard image: EXIF fix, downscale, fuse exposures, compress.

    Returns (success, corrected). The correction is reported and recorded rather
    than left implicit: a photograph in an expert report is evidence, so what was
    done to it has to stay answerable. The untouched original stays in the
    external asset directory either way.

    The EXIF block is carried over deliberately. A capture date per photo is
    routinely required, and DateTimeOriginal is the only evidence for it that
    survives a rename -- dropping it here is what left one report's asset stock
    undatable. Orientation is stripped instead: exif_transpose has already
    applied it to the pixels, so keeping the tag would rotate the image twice.
    """
    try:
        with Image.open(src_path) as handle:
            photograph = is_photograph(handle)
            img: Image.Image = ImageOps.exif_transpose(handle) or handle
            # Read the EXIF *after* the transpose. getexif() hands out the
            # image's own Exif object, not a copy, so popping Orientation first
            # deletes the very tag exif_transpose reads next -- and then nothing
            # rotates at all, silently, for every portrait frame in the stock.
            # exif_transpose clears the tag itself; the pop is belt to braces.
            exif = img.getexif()
            exif.pop(0x0112, None)  # Orientation, already baked into the pixels
            if img.mode in ("RGBA", "P"):
                img = img.convert("RGB")
            img.thumbnail(MAX_SIZE, Image.Resampling.LANCZOS)

            # Fused after downscaling: same result, a fraction of the work.
            corrected = tone and photograph
            if corrected:
                img = fuse_exposures(img)

            img.save(
                dest_path,
                "JPEG",
                quality=QUALITY,
                optimize=True,
                exif=exif.tobytes() if len(exif) else b"",
            )
        return True, corrected

    except Exception as e:
        print(f"  ✗ Error {src_path.name}: {e}")
        return False, False


def process_image_task(
    src_path: Path,
    dest_path: Path,
    meta: dict[str, float | int | str | bool],
    file_key: str,
    tone: bool,
) -> tuple[bool, str, dict[str, float | int | str | bool] | None]:
    """Process a single image: convert/downscale/correct, save. Runs in a worker.

    Returns (success_flag, file_key, meta).
    """
    dest_path.parent.mkdir(parents=True, exist_ok=True)

    if is_raw_file(src_path):
        success = process_raw(src_path, dest_path, tone)
        corrected = tone
    else:
        success, corrected = process_standard_image(src_path, dest_path, tone)

    if success:
        src_mb = float(meta["size"]) / (1024 * 1024)
        dst_kb = dest_path.stat().st_size / 1024
        fmt = "RAW" if is_raw_file(src_path) else "IMG"
        note = ", exposure fused" if corrected else ""
        print(f"  ✓ [{fmt}] {src_path.name}: {src_mb:.1f} MB → {dst_kb:.0f} KB{note}")
        if corrected:
            meta = {**meta, "corrected": TONE_METHOD}
        return True, file_key, meta

    return False, file_key, None


def prune_cache(
    cache: dict[str, dict[str, float | int | str | bool]],
    live_keys: set[str],
    dry_run: bool,
) -> int:
    """Drop cached files and hash entries whose source no longer exists.

    Without this, renaming a source directory doubles the cache: the new names
    get built and the old ones stay behind forever, indistinguishable from
    current output. Only files this script produces are ever removed.
    """
    removed = 0

    for cached in sorted(WORKSPACE_ASSETS.rglob("*.jpg")):
        rel = cached.relative_to(WORKSPACE_ASSETS)
        if str(rel.with_suffix("")) in live_keys:
            continue
        print(f"  ✗ {rel} (source gone)")
        if not dry_run:
            cached.unlink()
        removed += 1

    for stale in [k for k in cache if str(Path(k).with_suffix("")) not in live_keys]:
        cache.pop(stale)

    if not dry_run:
        for d in sorted(WORKSPACE_ASSETS.rglob("*"), reverse=True):
            if d.is_dir() and not any(d.iterdir()):
                d.rmdir()

    return removed


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--no-tone",
        action="store_true",
        help="skip exposure correction, copy the exposure through as it is",
    )
    parser.add_argument(
        "--force",
        action="store_true",
        help="ignore the cache and rebuild every file",
    )
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="report what would be built and pruned, write nothing",
    )
    args = parser.parse_args()
    tone = not args.no_tone
    tone_tag: str | bool = TONE_METHOD if tone else False

    # Fix rawpy/OpenMP deadlocks on Linux
    if multiprocessing.get_start_method(allow_none=True) != "spawn":
        multiprocessing.set_start_method("spawn", force=True)

    # OpenCV threads its own work; combined with a process pool that oversubscribes
    # every core and runs slower than either alone.
    cv2.setNumThreads(1)

    if not RAW_IMAGES_DIR or not RAW_IMAGES_DIR.exists():
        print("Info: Source directory for assets does not exist or is not configured.")
        print(f"  Please set {env_var_name} in your .env file!")
        if RAW_IMAGES_DIR:
            print(f"  Current value: {RAW_IMAGES_DIR}")
        return

    WORKSPACE_ASSETS.mkdir(parents=True, exist_ok=True)

    # Load hashes
    cache: dict[str, dict[str, float | int | str | bool]] = {}
    if HASH_FILE.exists():
        try:
            with HASH_FILE.open("r") as f:
                cache = json.load(f)
        except json.JSONDecodeError:
            pass

    # Find all supported image files recursively
    image_files = sorted(
        f for f in RAW_IMAGES_DIR.rglob("*") if f.is_file() and f.suffix.lower() in SUFFIXES_ALL
    )

    if not image_files:
        print(f"Info: No images found in {RAW_IMAGES_DIR}")
        return

    mode = []
    if not tone:
        mode.append("no exposure correction")
    if args.force:
        mode.append("forced rebuild")
    if args.dry_run:
        mode.append("dry run")
    suffix = f"  [{', '.join(mode)}]" if mode else ""
    print(f"📷 Found {len(image_files)} images in {RAW_IMAGES_DIR}{suffix}")

    total_processed = 0
    tasks = []
    live_keys: set[str] = set()

    # Check cache sequentially (fast, avoids process overhead)
    for img_path in image_files:
        rel_path = img_path.relative_to(RAW_IMAGES_DIR)
        dest_path = WORKSPACE_ASSETS / rel_path.with_suffix(".jpg")
        file_key = str(rel_path)
        meta = get_file_meta(img_path, tone_tag)
        live_keys.add(str(rel_path.with_suffix("")))

        cached = cache.get(file_key)
        if (
            not args.force
            and dest_path.exists()
            and cached
            and cached.get("mtime") == meta["mtime"]
            and cached.get("size") == meta["size"]
            # No default: an entry written before this method existed carries a
            # different tag or none, and has to rebuild whichever way the flag
            # is set. A default would pass off stale output as current.
            and cached.get("tone") == tone_tag
        ):
            continue  # Up-to-date

        tasks.append((img_path, dest_path, meta, file_key, tone))

    # Remove output whose source has disappeared (renamed or deleted directories)
    print("\n🧹 Pruning")
    removed = prune_cache(cache, live_keys, args.dry_run)
    print(f"  → {removed} orphaned file(s)" if removed else "  → nothing orphaned")

    if args.dry_run:
        print(f"\n✓ dry run: would build {len(tasks)}, would prune {removed}, nothing written")
        return

    # Process new/changed files in parallel using all CPU cores
    corrected = 0
    if tasks:
        cores = multiprocessing.cpu_count()
        print(f"\n→ Processing {len(tasks)} files using {cores} CPU cores...")
        with ProcessPoolExecutor(max_workers=cores) as executor:
            futures = [executor.submit(process_image_task, *task) for task in tasks]
            for future in as_completed(futures):
                success, file_key, meta_result = future.result()
                if success and meta_result is not None:
                    total_processed += 1
                    corrected += 1 if meta_result.get("corrected") else 0
                    cache[file_key] = meta_result

    total_skipped = len(image_files) - total_processed

    # Save hashes
    with HASH_FILE.open("w") as f:
        json.dump(cache, f, indent=2)

    print(f"\n✓ prepare-assets done: {total_processed} new/updated, {total_skipped} cached")
    if corrected:
        print(f"  {corrected} photograph(s) exposure-corrected by fusion")
    if total_processed > 0:
        print("  Use 'just add-photo <path/to/file.jpg>' to add specific assets to publication.")


if __name__ == "__main__":
    main()
