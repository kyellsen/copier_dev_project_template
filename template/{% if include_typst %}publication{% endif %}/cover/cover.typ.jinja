{% if publication_type == 'report' %}// cover.typ — Deckblatt (Gutachten)
#import "../config.typ": *

#page(numbering: none, margin: (
  top: 3cm,
  bottom: 2cm,
  left: 3cm,
  right: 2.5cm,
))[
  #set align(center)
  #v(0.5cm)

  #text(size: 14pt)[#my-doc-label]

  #v(1.0cm)

  #text(size: 20pt, weight: "bold")[#my-title]

  #v(0.6cm)

  #text(size: 11pt, style: "italic")[#my-subtitle]

  #v(1.0cm)

  #image(my-cover-picture, width: 38%)

  #v(1.0cm)

  #grid(
    columns: (auto, auto),
    align: (right, left),
    column-gutter: 12pt,
    row-gutter: 8pt,
    [*Gutachten-Nr.:*], [#my-report-no],
    [*Stichtag:*], [#my-survey-date],
    [*Auftraggeber\*In:*], [#my-client],
    [*Gegenstand:*], [#my-subject],
    [*Flurstück:*], [#my-parcel],
    ..if my-copies != none { ([*Ausfertigungen:*], [#my-copies]) } else { () },
  )

  #v(1fr)

  #text[erstellt von #my-author, #my-author-address\ #link("mailto:" + my-author-email)[#my-author-email] — Stand: #my-date]
  #if my-qualification != none [
    \ #text(size: 10pt)[#my-qualification]
  ]
]
{% else %}// cover.typ — Deckblatt
#import "../config.typ": *

#page(numbering: none, margin: (top: 3cm, bottom: 2cm, left: 3cm, right: 2.5cm))[
  #set align(center)
  #v(0.5cm)

  #text(size: 14pt)[Projektbericht]

  #v(1.2cm)

  #text(size: 20pt, weight: "bold")[#my-title]

  #v(1.2cm)

  #image(my-cover-picture, width: 40%)

  #v(1.2cm)

  #text(size: 14pt)[erstellt von #my-author\ am #my-date]

  #v(0.8cm)

  #text[#my-author\ #link("mailto:" + my-author-email)[#my-author-email]]

  #v(1fr)
]
{% endif %}