// === Projektmetadaten ===
#let my-title = "{{ project_name }}"
#let my-subtitle = "{{ description }}"
#let my-author = "{{ author }}"
#let my-author-email = "{{ author_email }}"
#let my-date = datetime.today().display("[day].[month].[year]")
#let my-keywords = ("{{ project_name }}",)
{% if publication_type == 'report' %}
// === Gutachten-Fakten (Deckblatt, Footer, Unterschriftsblock) ===
#let my-doc-label = "Baumgutachten"
#let my-report-no = "00000 (Entwurf)"
#let my-client = "Auftraggeber (Name, Anschrift)"
#let my-subject = "Gegenstand des Gutachtens"
#let my-parcel = "Flur …, Flurstück … (Gemeinde …)"
#let my-survey-date = "Stichtag offen"
#let my-place = "Timmdorf"
#let my-author-address = "Lindenweg 4, 23714 Timmdorf"
// Optional (none = wird nicht gerendert): Sachkunde-Nachweis und Ausfertigungen
#let my-qualification = none // z. B. "FLL-zertifizierter Baumkontrolleur"
#let my-copies = none // z. B. "1 Ausfertigung als PDF"
{% endif %}

// === Semantische Farben ===
#let color-code-bg = luma(245)
#let color-link = rgb(0, 80, 160)
#let color-accent = rgb(0, 100, 80)

// === Pfade & Medien ===
#let my-cover-picture = "cover_picture.png"
