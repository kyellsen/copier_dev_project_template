// main.typ — {{ project_name }}
// Engine: typst compile | Build: typst compile main.typ

#import "config.typ": *
#import "lib/data.typ": *
#import "@preview/unify:0.8.0": num, qty, unit

// === Dokument-Metadaten (PDF) ===
#set document(
  title: my-title,
  author: my-author,
  keywords: my-keywords,
)

// === Seitenlayout (DIN A4, Standard-Seitenränder) ===
#set page(
  paper: "a4",
  numbering: "1",
  margin: (top: 2.5cm, bottom: 2cm, left: 3cm, right: 2.5cm),
)

// === Schrift & Typografie ===
// Libertinus Serif — moderner Palatino/Linux Libertine Fork mit exzellenten Mathe-Glyphen.
#set text(
  font: "Libertinus Serif",
  size: 11pt,
  lang: "de",
  region: "DE",
)

// Blocksatz, DIN 5008-konformer Zeilenabstand
#set par(justify: true, leading: 0.8em, spacing: 1.2em)

// === Überschriften & Formeln ===
// DIN 1421: Maximal 3 nummerierte Gliederungsebenen
#set heading(numbering: "1.1")
#set math.equation(numbering: "(1)")

// Ebene 4+: unnummerierte Darstellung, nicht im Inhaltsverzeichnis, aber im PDF-Bookmark
#show heading.where(level: 4): set heading(outlined: false, bookmarked: true)
#show heading.where(level: 4): it => {
  v(0.5em)
  text(weight: "bold", size: 1em, it.body)
  v(0.3em)
}

// Hauptkapitel (Ebene 1) beginnen auf einer neuen Seite
#show heading.where(level: 1): it => {
  pagebreak(weak: true)
  v(1em)
  it
  v(1em)
}

// === Abbildungen & Tabellen ===
// Tabellen-Überschriften gehören nach oben
#show figure.where(kind: table): set figure.caption(position: top)

// --- Booktabs-Style Tabellen ---
#show table: set table(stroke: none, inset: (x: 8pt, y: 6pt))
#show table: set par(leading: 0.65em)

// === Quellcode ===
#show raw.where(block: true): it => {
  block(
    fill: color-code-bg,
    inset: 8pt,
    radius: 2pt,
    width: 100%,
    it,
  )
}

// === Hyperlinks ===
#show link: set text(fill: color-link)

// ======================================================================
// DOKUMENT
// ======================================================================

// --- Deckblatt ---
#include "cover/cover.typ"

// --- Verzeichnisse ---
// Römische Seitenzahlen für Verzeichnisse (optional, aber in MINT oft üblich)
#set page(numbering: "I")
#counter(page).update(1)

#outline(title: "Inhaltsverzeichnis", depth: 3, indent: auto)
#pagebreak()

// --- Abbildungs- & Tabellenverzeichnis (bei Bedarf aktivieren) ---
// #heading(numbering: none, outlined: true)[Abbildungsverzeichnis]
// #outline(title: none, target: figure.where(kind: image))
// #pagebreak()
//
// #heading(numbering: none, outlined: true)[Tabellenverzeichnis]
// #outline(title: none, target: figure.where(kind: table))
// #pagebreak()

// --- Formelzeichenverzeichnis (automatisch via `just symbols` generiert) ---
// #heading(numbering: none, outlined: true)[Formelzeichenverzeichnis]
// #include "tables/symbols.typ"
// #pagebreak()

// Zurück zu arabischen Seitenzahlen für den Hauptteil
#set page(numbering: "1")
#counter(page).update(1)

// === Hauptteil ===
#heading(level: 1)[Einleitung]
Dies ist eine Typst-Vorlage für #my-title. Sie nutzt bewusst die nativen Typst-Standards, 
welche für MINT-Publikationen exzellent geeignet sind, und verzichtet auf unnötiges Over-Engineering.

// Zahlen & Einheiten lassen sich DIN-konform mit unify oder den data-helpers setzen:
// Beispiel: #qty("42.5", "kN") oder #val(res.force_max)

// === Literaturverzeichnis ===
#heading(numbering: none, outlined: true)[Literaturverzeichnis]
#bibliography("literature/references.bib", title: none, style: "apa")

