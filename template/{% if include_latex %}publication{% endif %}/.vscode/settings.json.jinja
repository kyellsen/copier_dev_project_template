{
  // Automatisches Speichern
  "files.autoSave": "onFocusChange",
  "files.autoSaveDelay": 1000,

  // Formatierung
  "editor.formatOnSave": false,
  "[latex]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "James-Yu.latex-workshop"
  },

  // LTeX Plus – Sprach-/Grammatikprüfung
  "ltex.enabled": true,
  "ltex.enabledLanguageIds": ["latex", "markdown", "plaintext"],
  "ltex.checkFrequency": "save",
  "ltex.workspaceFolderScope": "openFiles",
  "ltex.sentenceCacheSize": 2000,
  "ltex.diagnosticSeverity": "information",
  "ltex.language": "de-DE",
  "ltex.additionalLanguages": ["en-GB"],
  "ltex.additionalRules.motherTongue": "de-DE",
  "ltex.ignorePaths": ["build/**", ".git/**"],
  "ltex.latex.commands": {
    "\\cite{}": "dummy",
    "\\parencite{}": "dummy",
    "\\textcite{}": "dummy"
  },

  // LaTeX Workshop
  "latex-workshop.view.pdf.viewer": "external",
  "latex-workshop.view.pdf.external.viewer.command": "okular",
  "latex-workshop.view.pdf.external.viewer.args": [
    "--unique",
    "build/%DOCFILE%.pdf#src:%LINE% %TEX%"
  ],
  "latex-workshop.synctex.afterBuild.enabled": true,
  "latex-workshop.message.log.show": "error",

  // Build-Ordner
  "latex-workshop.latex.outDir": "build",
  "latex-workshop.latex.clean.subfolder.enabled": true,
  "latex-workshop.latex.autoClean.run": "never",
  "latex-workshop.latex.autoBuild.run": "never",

  // ChkTeX (Lint)
  "latex-workshop.linting.chktex.enabled": true,
  "latex-workshop.linting.ignorePatterns": [
    "**/build/**",
    "**/*.aux",
    "**/*.bbl",
    "**/*.blg"
  ],

  "latex-workshop.intellisense.citation.format": "biblatex",

  "latex-workshop.latex.tools": [
    {
      "name": "latexmk (pdflatex)",
      "command": "latexmk",
      "args": [
        "%DOC%"
      ]
    }
  ],
  "latex-workshop.latex.recipes": [
    {
      "name": "pdfLaTeX",
      "tools": ["latexmk (pdflatex)"]
    }
  ],

  // Hygiene & Editor
  "files.exclude": { "**/.git": true, "**/build": true },
  "search.exclude": { "**/build": true },
  "editor.wordWrap": "on",
  "editor.rulers": [100],
  "files.trimTrailingWhitespace": true
}
