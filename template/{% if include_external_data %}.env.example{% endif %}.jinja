# ================================================================
# External Nextcloud Data Directories
# Fill in the paths to your experiment data on Nextcloud / NAS.
# Examples:
# PROJECT_DATA_ROOT=/mnt/data/kyellsen/300_Projekte/2027_MeinProjekt
{% if include_latex %}
# Ordner für rohe Publikations-Assets (z.B. unkomprimierte Original-Fotos/Grafiken):
{{ python_module_name | upper }}_RAW_ASSETS_DIR=/mnt/data/kyellsen/300_Projekte/202x_XYZ/data/raw/publication_assets
{% endif %}
# ================================================================

{% if not workspace_is_internal %}
# ================================================================
# Workspace Path (intermediate data: Parquet, DuckDB, plots)
# Generated data lives here — not backed up, fully regenerable.
# ================================================================
WORKSPACE_ROOT=/mnt/data/dev_workspaces/{{ project_name }}
{% endif %}
