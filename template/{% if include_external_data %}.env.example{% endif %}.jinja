# ================================================================
# External Nextcloud Data Directories
# Fill in the paths to your project data on Nextcloud / NAS.
# Examples:
# {{ python_module_name | upper }}_DATA_ROOT=~/data/300_Projekte/2027_MeinProjekt
{% if include_photo_pipeline %}
# The stock of original images: raw photographs, uncompressed exports, NEF
# files. A root that has a media/ subdirectory is read there, otherwise as it
# stands, so a folder made by copier_project fits without further configuration.
{{ python_module_name | upper }}_RAW_ASSETS_DIR=~/data/300_Projekte/202x_XYZ/media

# Several image stocks instead of one: name them here, comma-separated, and
# each name X is then read from {{ python_module_name | upper }}_X_ROOT and switched
# by {{ python_module_name | upper }}_PIPELINE_X. Left empty, the single stock above applies.
# {{ python_module_name | upper }}_ASSET_SOURCES=site_a,site_b

# Exposure correction by fusion, on by default. Set to 0 where the images are
# evidence of a measurement rather than illustration, and must not be altered.
# {{ python_module_name | upper }}_ASSET_TONE=0
{% endif %}
# ================================================================

{% if workspace_location_external %}
# ================================================================
# Workspace Path (intermediate data: Parquet, DuckDB, plots)
# Generated data lives here — not backed up, fully regenerable.
# ================================================================
{{ python_module_name | upper }}_WORKSPACE_ROOT=~/workspaces/{{ project_name }}
{% endif %}
