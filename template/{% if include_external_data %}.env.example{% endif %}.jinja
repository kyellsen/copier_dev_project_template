# ================================================================
# External Nextcloud Data Directories
# Fill in the paths to your experiment data on Nextcloud / NAS.
# Examples:
# PROJECT_DATA_ROOT=~/data/300_Projekte/2027_MeinProjekt
{% if include_photo_pipeline %}
# Ordner für rohe Publikations-Assets (z.B. unkomprimierte Raw-Fotos/Grafiken):
{{ python_module_name | upper }}_RAW_ASSETS_DIR=~/data/300_Projekte/202x_XYZ/data/raw/publication_assets
{% endif %}
# ================================================================

{% if workspace_location_external %}
# ================================================================
# Workspace Path (intermediate data: Parquet, DuckDB, plots)
# Generated data lives here — not backed up, fully regenerable.
# ================================================================
WORKSPACE_ROOT=~/workspaces/{{ project_name }}
{% endif %}
