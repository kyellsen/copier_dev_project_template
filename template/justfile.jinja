set dotenv-load

# === Default ===
default:
    @just --list

# === Setup ===
alias s := setup
setup:
    uv run python scripts/setup.py
{% if include_external_data %}
# === Environment Check ===
check-env:
    uv run python scripts/check_env.py
{% endif %}
# === Code Quality ===
lint:
    @uv run ruff check .

alias c := check
check:
    @uv run python scripts/check.py

fix:
    @echo "\033[1m\033[95m🚀 Auto-fixing Code Quality Issues\033[0m"
    uv run ruff format .
    uv run ruff check --fix .

# === Testing ===
test-unit:
    @echo "\033[1m\033[95m🚀 Running Unit Tests\033[0m"
    uv run pytest tests/unit -m unit -q -rs || test $? -eq 5

test-int:
    @echo "\033[1m\033[95m🚀 Running Integration Tests\033[0m"
    uv run pytest tests/integration -m integration -q -rs || test $? -eq 5

test-system:
    @echo "\033[1m\033[95m🚀 Running System Tests\033[0m"
    uv run pytest tests/system -m system -q -rs || test $? -eq 5

alias t := test
test: test-unit test-int

test-all: test-unit test-int test-system

# === CI Pipeline ===
ci: check test-all

# === Interactive ===
lab:
    uv run jupyter lab

# === Data Pipeline ===
alias ana := analyze
analyze:
    @echo "\033[1m\033[93m⚠️ 'analyze' target not implemented yet. Add it to your justfile.\033[0m"

alias plt := plot
plot:
    @echo "\033[1m\033[93m⚠️ 'plot' target not implemented yet. Add it to your justfile.\033[0m"

alias pip := pipeline
pipeline:
    @echo "\033[1m\033[93m⚠️ 'pipeline' target not implemented yet. Combine your steps here.\033[0m"
{% if include_typst %}
# === Typst ===
alias pub := publication
publication:
    cd publication && typst compile main.typ

alias pub-watch := publication-watch
publication-watch:
    cd publication && typst watch main.typ

# === Freeze ===
prepare-assets:
    uv run python scripts/prepare_assets.py

freeze:
    uv run python scripts/freeze.py
{% endif %}
# === Cleanup (3 Stages) ===
# 🧹 Stage 1: Clear caches (safe, daily)
clean:
    @uv run python scripts/clean.py

# 🧼 Stage 2: clean + remove .venv (reinstall required: just setup)
distclean: clean
    rm -rf .venv
    @echo "✓ .venv removed. Run 'just setup' to reinstall."

# ☢️  Stage 3: distclean + Workspace + Build artifacts (Factory Reset)
nuke: distclean
{% if not workspace_location_external %}    rm -rf _workspace/*
    @mkdir -p _workspace/output/figures _workspace/output/tables{% if include_typst %} _workspace/output/assets{% endif %}
{% else %}    @test -n "${WORKSPACE_ROOT}" || (echo "WORKSPACE_ROOT is empty"; exit 1)
    @test "${WORKSPACE_ROOT}" != "/" || (echo "Refusing to clean /"; exit 1)
    @test "${WORKSPACE_ROOT}" != "$HOME" || (echo "Refusing to clean HOME"; exit 1)
    @test "${WORKSPACE_ROOT}" != "/mnt/data" || (echo "Refusing to clean /mnt/data"; exit 1)
    @test -d "${WORKSPACE_ROOT}" || (echo "Workspace not found"; exit 1)
    rm -rf "${WORKSPACE_ROOT:?}"/*
    @echo "✓ Workspace cleaned."
{% endif %}    @echo "✓ Factory Reset. Run 'just setup' to start fresh."
