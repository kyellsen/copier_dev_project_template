set dotenv-load

# === Default ===
default:
    @just --list

# === Setup ===
alias s := setup
setup:
    uv run python scripts/setup.py
{% if include_external_data %}
# === Environment Check ===
check-env:
    uv run python scripts/check_env.py
{% endif %}
# === Code Quality ===
lint:
    @uv run ruff check src/

alias c := check
check:
    @uv run python scripts/check.py

fix:
    @uv run python scripts/fix.py

# === Testing ===
test-unit:
    @uv run python scripts/test.py unit

test-int:
    @uv run python scripts/test.py integration

test-system:
    @uv run python scripts/test.py system

test: test-unit test-int

test-all: test-unit test-int test-system

# === CI Pipeline ===
ci: check test-all

# === Interactive ===
lab:
    uv run jupyter lab
{% if include_latex %}
# === LaTeX ===
publication:
    cd publication && latexmk -pdf -outdir=build -interaction=nonstopmode main.tex
publication-clean:
    cd publication && latexmk -C -outdir=build
publication-watch:
    cd publication && latexmk -pdf -pvc -outdir=build main.tex

# === Freeze ===
prepare-assets:
    uv run python scripts/prepare_assets.py

freeze:
    uv run python scripts/freeze.py
{% endif %}
# === Cleanup (3 Stufen) ===
# 🧹 Stufe 1: Caches löschen (gefahrlos, täglich)
clean:
    @uv run python scripts/clean.py

# 🧼 Stufe 2: clean + .venv löschen (Neuinstallation nötig: just setup)
distclean: clean
    rm -rf .venv
    @echo "✓ .venv gelöscht. Run 'just setup' to reinstall."

# ☢️  Stufe 3: distclean + Workspace + Build-Artefakte (Factory Reset)
nuke: distclean
{% if workspace_is_internal %}    rm -rf _workspace/*
    @mkdir -p _workspace/output/figures _workspace/output/tables
{% else %}    @test -d "${WORKSPACE_ROOT}" && rm -rf ${WORKSPACE_ROOT}/* && echo "✓ Workspace cleaned." || echo "⚠ Workspace not found"
{% endif %}{% if include_latex %}    rm -rf publication/build/
{% endif %}    @echo "✓ Factory Reset. Run 'just setup' to start fresh."
