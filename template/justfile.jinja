set dotenv-load

# === Default ===
default:
    @just --list

# === Setup ===
setup:
    uv run python scripts/setup.py
{% if include_external_data %}
# === Environment Check ===
check-env:
    @test -f .env || (echo "✗ .env fehlt! Kopiere .env.example → .env" && exit 1)
{% if not workspace_is_internal %}    @test -n "${WORKSPACE_ROOT}" || (echo "✗ WORKSPACE_ROOT fehlt in .env" && exit 1)
    @echo "✓ WORKSPACE_ROOT = ${WORKSPACE_ROOT}"
{% endif %}    @echo "✓ Umgebung ok"
{% endif %}
# === Quality Assurance ===
lint:
    uv run ruff check src/
    uv run mypy src/

format:
    uv run ruff format src/
    uv run ruff check --fix src/

test:
    uv run pytest tests/

# === Interactive ===
lab:
    uv run jupyter lab

# === Workspace ===
{% if workspace_is_internal %}clean-workspace:
    rm -rf _workspace/*
    @mkdir -p _workspace/output/figures _workspace/output/tables
    @echo "✓ Workspace cleaned (_workspace/). Run 'just pipeline-all' to rebuild."
{% else %}clean-workspace:
    @test -d "${WORKSPACE_ROOT}" && rm -rf ${WORKSPACE_ROOT}/* && echo "✓ Workspace ${WORKSPACE_ROOT} cleaned." || echo "✗ Workspace not found"
{% endif %}
