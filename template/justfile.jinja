set dotenv-load

# Project-specific recipes, if any. Overlay templates (report, thesis) drop a
# project.just here; the '?' keeps this a no-op when there is none.
import? 'project.just'

# === Default ===
# A bare `just` answers one question: what do I type today? Everything else is
# one command away. Without this, a first-time reader meets thirty recipes in
# alphabetical order and cannot tell which three matter.
# The everyday commands — `just --list` shows all of them, grouped
default:
{%- if include_typst %}
    @echo "  just pub        compile the document"
    @echo "  just pub-watch  recompile on every save, open in the viewer"
{%- endif %}
    @echo "  just check      the quality gate — run it before you commit"
    @echo "  just fix        auto-format and auto-fix what check complains about"
    @echo ""
    @echo "  everything else, grouped by when you need it:  just --list"

# === Setup ===
alias s := setup

# Create the venv and install everything the project needs
[group('setup')]
setup:
    uv run python scripts/setup.py
    @just canon-pull
{% if include_precommit %}    @just install-hooks
{% endif %}
{% if include_precommit %}
# === Git Hooks ===

# The hook is versioned in scripts/git-hooks and wired in with core.hooksPath,
# so it survives a fresh clone and is reviewed like any other file. It runs
# 'just check' — the same command you run — and stashes nothing: the gate judges
# the working tree, so what you see is what is tested. The pre-commit framework
# does the opposite; its red hook is only a suspicion because it hides unstaged
# work, and the honest reaction to that is --no-verify, which voids the gate.

# Wire the versioned git hook into this clone (setup does it too)
[group('setup')]
install-hooks:
    git config core.hooksPath scripts/git-hooks
    @echo "✅ core.hooksPath → scripts/git-hooks"

# Remove the git hook from this clone
[group('setup')]
uninstall-hooks:
    git config --unset core.hooksPath || true
    @echo "✅ core.hooksPath unset"
{% endif %}
{% if include_external_data %}
# === Environment Check ===

# Verify .env paths and external data roots actually exist
[group('setup')]
check-env:
    uv run python scripts/check_env.py
{% endif %}
# === Code Quality ===

# Report lint findings only (no formatting, no type check)
[group('plumbing')]
lint:
    @uv run ruff check .

alias c := check

# Static quality gate: what CI runs. Run it before you commit.
[group('daily')]
check:
    @uv run python scripts/check.py

# Auto-fix what can be fixed: format, then apply safe lint fixes
[group('daily')]
fix:
    @echo "\033[1m\033[95m🚀 Auto-fixing Code Quality Issues\033[0m"
    uv run ruff format .
    uv run ruff check --fix .

# Refresh AGENTS.canon.md from ~/code/_templates/agents_canon
[group('setup')]
canon-pull:
    #!/usr/bin/env bash
    set -euo pipefail
    # .agents-canon wins once it exists. The copier answer only bootstraps the
    # first pull: a project may add a profile later by editing that file, and a
    # stale answer must never silently narrow it back. That exact near-miss
    # happened on 2026-08-18, when the base template still shipped its own
    # AGENTS.canon.md and an update offered to drop 40-science from a report.
    if [ -f .agents-canon ]; then
        ~/code/_templates/agents_canon/sync.sh .
    else
        ~/code/_templates/agents_canon/sync.sh . "{{ canon_profiles }}"
    fi

# Report whether this repo's canon pin is behind the canon repo
[group('setup')]
canon-outdated:
    @cd ~/code/_templates/agents_canon && just outdated
{% if include_typst %}
# === Typst Quality ===

# Check Typst formatting without writing (typstyle --check)
[group('plumbing')]
check-typst:
    @echo "\033[1m\033[96mChecking Typst Formatting\033[0m"
    typstyle --check publication/
{% endif %}
# === Testing ===
# Exit code 5 is pytest's "no tests collected" — expected while a suite is
# still empty, so it is tolerated instead of failing the run.

# Run unit tests only (fast, no I/O)
[group('plumbing')]
test-unit:
    @echo "\033[1m\033[95m🚀 Running Unit Tests\033[0m"
    uv run pytest tests/unit -m unit -q -rs || test $? -eq 5

# Run integration tests (touches files, DB, network fixtures)
[group('plumbing')]
test-int:
    @echo "\033[1m\033[95m🚀 Running Integration Tests\033[0m"
    uv run pytest tests/integration -m integration -q -rs || test $? -eq 5

# Run system tests (slow, end-to-end; not part of 'just test')
[group('plumbing')]
test-system:
    @echo "\033[1m\033[95m🚀 Running System Tests\033[0m"
    uv run pytest tests/system -m system -q -rs || test $? -eq 5

alias t := test

# The everyday test run: unit + integration
[group('release')]
test: test-unit test-int

# Everything including the slow system tests
[group('release')]
test-all: test-unit test-int test-system

# === CI Pipeline ===

# What CI runs — same checks as 'just check', machine-readable output
[group('release')]
ci:
    @uv run python scripts/check.py --ci

# === Interactive ===

# Start Jupyter Lab in the project venv
[group('data')]
lab:
    uv run jupyter lab

# === Data Pipeline ===
alias ana := analyze

# Project-specific: your analysis entry point
[group('data')]
analyze:
    @echo "\033[1m\033[93m⚠️ 'analyze' target not implemented yet. Add it to your justfile.\033[0m"

alias plt := plot

# Project-specific: regenerate figures
[group('data')]
plot:
    @echo "\033[1m\033[93m⚠️ 'plot' target not implemented yet. Add it to your justfile.\033[0m"

alias pip := pipeline

# Project-specific: chain the steps above into one reproducible run
[group('data')]
pipeline:
    @echo "\033[1m\033[93m⚠️ 'pipeline' target not implemented yet. Combine your steps here.\033[0m"
{% if include_typst %}
# === Typst ===

# Export Formelzeichenverzeichnis from ColumnDef schemas → publication/tables/symbols.typ
[group('data')]
symbols:
    @test -f scripts/export_symbols.py && uv run python scripts/export_symbols.py || echo "ℹ️ scripts/export_symbols.py not found"

alias pub := publication

# Compile publication/main.typ once
[group('daily')]
publication:
    cd publication && typst compile main.typ

alias pw := publication-watch
alias pub-watch := publication-watch

# Compile, open in Okular, then recompile on every save
[group('daily')]
publication-watch:
    cd publication && typst compile main.typ && (okular main.pdf > /dev/null 2>&1 &) && typst watch main.typ

alias export := export-pdf

# Copy the compiled PDF out under a chosen name (and to the Nextcloud outbox if set)
[group('release')]
export-pdf filename:
    @test -f publication/main.pdf || (echo "❌ publication/main.pdf not found. Run 'just pub' first." && exit 1)
    @cp publication/main.pdf "{{ '{{filename}}' }}.pdf"
    @echo "✅ Exported to {{ '{{filename}}' }}.pdf"
    @if [ -n "$BA_KS_DATA_ROOT" ] && [ -d "$BA_KS_DATA_ROOT/outbox" ]; then \
        cp publication/main.pdf "$BA_KS_DATA_ROOT/outbox/{{ '{{filename}}' }}.pdf" && \
        echo "✅ Exported to Nextcloud outbox: $BA_KS_DATA_ROOT/outbox/{{ '{{filename}}' }}.pdf"; \
    elif [ -n "$DATA_ROOT" ] && [ -d "$DATA_ROOT/outbox" ]; then \
        cp publication/main.pdf "$DATA_ROOT/outbox/{{ '{{filename}}' }}.pdf" && \
        echo "✅ Exported to Nextcloud outbox: $DATA_ROOT/outbox/{{ '{{filename}}' }}.pdf"; \
    fi

# === Assets & Freeze ===

# Build compressed photo cache from RAW_ASSETS_DIR (NEF→JPG, downscale)
[group('data')]
prepare-assets:
    uv run python scripts/prepare_assets.py

alias add-asset := add-photo

# Copy a single photo from cache to publication (e.g. just add-photo subdir/IMG_2313.jpg)
[group('data')]
add-photo file:
    @mkdir -p "publication/assets/$(dirname {{ '{{file}}' }})"
{% if not workspace_location_external %}    @cp "_workspace/output/assets/{{ '{{file}}' }}" "publication/assets/{{ '{{file}}' }}"
{% else %}    @test -n "${WORKSPACE_ROOT}" || (echo "WORKSPACE_ROOT is empty"; exit 1)
    @cp "${WORKSPACE_ROOT}/output/assets/{{ '{{file}}' }}" "publication/assets/{{ '{{file}}' }}"
{% endif %}    @echo "✓ Copied: publication/assets/{{ '{{file}}' }}"
    @echo "  Typst:  image(\"../../assets/{{ '{{file}}' }}\")"

# Smart-sync pipeline outputs (figures + tables) and refresh committed photos
[group('data')]
freeze:
    uv run python scripts/freeze.py
{% endif %}
# === Cleanup (3 Stages) ===

# 🧹 Stage 1: Clear caches (safe, daily)
[group('plumbing')]
clean:
    @uv run python scripts/clean.py

# 🧼 Stage 2: clean + remove .venv (reinstall required: just setup)
[group('plumbing')]
distclean: clean
    rm -rf .venv
    @echo "✓ .venv removed. Run 'just setup' to reinstall."

# The guards below are the safety net instead of a prompt: nuke stays
# non-interactive so it can run unattended, but it refuses to delete an
# unset, root, HOME or missing workspace path.
# ☢️  Stage 3: distclean + Workspace + Build artifacts (Factory Reset)
[group('plumbing')]
nuke: distclean
{% if not workspace_location_external %}    rm -rf _workspace/*
    @mkdir -p _workspace/output/figures _workspace/output/tables{% if include_typst %} _workspace/output/assets{% endif %}
{% else %}    @test -n "${WORKSPACE_ROOT}" || (echo "WORKSPACE_ROOT is empty"; exit 1)
    @test "${WORKSPACE_ROOT}" != "/" || (echo "Refusing to clean /"; exit 1)
    @test "${WORKSPACE_ROOT}" != "$HOME" || (echo "Refusing to clean HOME"; exit 1)
    @test "${WORKSPACE_ROOT}" != "${HOME}/data" || (echo "Refusing to clean ${HOME}/data"; exit 1)
    @test -d "${WORKSPACE_ROOT}" || (echo "Workspace not found"; exit 1)
    rm -rf "${WORKSPACE_ROOT:?}"/*
    @echo "✓ Workspace cleaned."
{% endif %}    @echo "✓ Factory Reset. Run 'just setup' to start fresh."
