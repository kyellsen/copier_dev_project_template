set dotenv-load

# Project-specific recipes, if any. Overlay templates (report, thesis) drop a
# project.just here; the '?' keeps this a no-op when there is none.
import? 'project.just'

# === Default ===
# --unsorted preserves the section order of this file, so a first-time reader
# meets the recipes in the order they are needed rather than alphabetically.
# The canon fixes this recipe's body; a hand-written summary beside it is a
# second list of the important verbs, and the copy is the one that goes stale.

# Show all recipes, grouped by section
default:
    @just --list --unsorted

# === Setup ===
alias s := setup

# Create the venv and install everything the project needs
[group('setup')]
setup:
    uv run python scripts/setup.py
    @just canon-pull
{% if git_hooks != 'none' %}    @just install-hooks
{% endif %}
{% if git_hooks != 'none' %}
# === Git Hooks ===

# This project stands on rung '{{ git_hooks }}' of the ladder. Every hook is
# versioned in scripts/git-hooks and wired in with core.hooksPath, so it
# survives a fresh clone and is reviewed like any other file.
#
#   commit-msg   the commit convention as a regular expression, milliseconds
#   pre-commit   'just check' — the static gate, no tests
#   pre-push     'just check test' — adds unit and integration
#
# What each rung may and may not do is a house rule, not a project decision:
# AGENTS.canon.md, "Git hooks".

# Wire the versioned git hooks into this clone (setup does it too)
[group('setup')]
install-hooks:
    git config core.hooksPath scripts/git-hooks
    @echo "✅ core.hooksPath → scripts/git-hooks"

# Remove the git hooks from this clone
[group('setup')]
uninstall-hooks:
    git config --unset core.hooksPath || true
    @echo "✅ core.hooksPath unset"
{% endif %}
{% if include_external_data %}
# === Environment Check ===

# Verify .env paths and external data roots actually exist
[group('setup')]
check-env:
    uv run python scripts/check_env.py
{% endif %}
# === Code Quality ===

# Report lint findings only (no formatting, no type check)
[group('plumbing')]
lint:
    @uv run ruff check .

alias c := check

# Static quality gate: what CI runs. Run it before you commit.
[group('daily')]
check:
    @uv run python scripts/check.py

# Auto-fix what can be fixed: format, then apply safe lint fixes
[group('daily')]
fix:
    @uv run python scripts/fix.py

# Refresh AGENTS.canon.md from ~/code/_templates/agents_canon
[group('setup')]
canon-pull:
    #!/usr/bin/env bash
    set -euo pipefail
    # .agents-canon wins once it exists. The copier answer only bootstraps the
    # first pull: a project may add a profile later by editing that file, and a
    # stale answer must never silently narrow it back. That exact near-miss
    # happened on 2026-08-18, when the base template still shipped its own
    # AGENTS.canon.md and an update offered to drop 40-science from a report.
    if [ -f .agents-canon ]; then
        ~/code/_templates/agents_canon/sync.sh .
    else
        ~/code/_templates/agents_canon/sync.sh . "{{ canon_profiles }}"
    fi

# Report whether this repo's canon pin is behind the canon repo
[group('setup')]
canon-outdated:
    @cd ~/code/_templates/agents_canon && just outdated
{% if include_typst %}
# === Typst Quality ===

# The gate owns this check -- scripts/check.py runs it as "Typst Format Check"
# over the hand-written files. This recipe is the fast subset, the way `lint`
# relates to `check`: it skips the Python stages when all you changed is a .typ
# file. Both go through scripts/fix.py, so the file list has one owner.

# Fast subset: Typst formatting only, without writing (the gate runs it too)
[group('plumbing')]
check-typst:
    @uv run python scripts/fix.py --check
{% endif %}
# === Testing ===
# Exit code 5 is pytest's "no tests collected" — expected while a suite is
# still empty, so it is tolerated instead of failing the run.

# Run unit tests only (fast, no I/O)
[group('plumbing')]
test-unit:
    @printf "\033[1m\033[95m🚀 Running Unit Tests\033[0m\n"
    uv run pytest tests/unit -m unit -q -rs || test $? -eq 5

# Run integration tests (touches files, DB, network fixtures)
[group('plumbing')]
test-int:
    @printf "\033[1m\033[95m🚀 Running Integration Tests\033[0m\n"
    uv run pytest tests/integration -m integration -q -rs || test $? -eq 5

# Run system tests (slow, end-to-end; not part of 'just test')
[group('plumbing')]
test-system:
    @printf "\033[1m\033[95m🚀 Running System Tests\033[0m\n"
    uv run pytest tests/system -m system -q -rs || test $? -eq 5

alias t := test

# The everyday run, and what pre-push runs: unit + integration
[group('release')]
test: test-unit test-int

# Every tier a machine can run — hardware and manual tiers never go here
[group('release')]
test-all: test-unit test-int test-system

# === CI Pipeline ===

# Composition, not a mode: the tier list lives in the recipes above and nowhere
# else. This used to be a CI mode inside check.py, which meant the script
# carried a second copy of it — and the copy that drifts is the one nobody reads.

# The CI entry point: the gate, then every tier a machine can run
[group('release')]
ci: check test-all

# === Interactive ===

# Start Jupyter Lab in the project venv
[group('data')]
lab:
    uv run jupyter lab

# === Data Pipeline ===
alias ana := analyze

# Project-specific: your analysis entry point
[group('data')]
analyze:
    @printf "\033[1m\033[93m⚠️ 'analyze' target not implemented yet. Add it to your justfile.\033[0m\n"

alias plt := plot

# Project-specific: regenerate figures
[group('data')]
plot:
    @printf "\033[1m\033[93m⚠️ 'plot' target not implemented yet. Add it to your justfile.\033[0m\n"

alias pip := pipeline

# Project-specific: chain the steps above into one reproducible run
[group('data')]
pipeline:
    @printf "\033[1m\033[93m⚠️ 'pipeline' target not implemented yet. Combine your steps here.\033[0m\n"
{% if include_typst %}
# === Typst ===

# Export Formelzeichenverzeichnis from ColumnDef schemas → publication/tables/symbols.typ
[group('data')]
symbols:
    @test -f scripts/export_symbols.py && uv run python scripts/export_symbols.py || echo "ℹ️ scripts/export_symbols.py not found"

alias pub := publication

# Compile publication/main.typ once
[group('daily')]
publication:
    cd publication && typst compile main.typ

alias pw := publication-watch
alias pub-watch := publication-watch

# Compile, open the PDF viewer, then recompile on every save
[group('daily')]
publication-watch:
    uv run python scripts/publication_watch.py

alias export := export-pdf

# Copy the compiled PDF out under a chosen name (and to the Nextcloud outbox if set)
[group('release')]
export-pdf filename:
    @test -f publication/main.pdf || (echo "❌ publication/main.pdf not found. Run 'just pub' first." && exit 1)
    @cp publication/main.pdf "{{ '{{filename}}' }}.pdf"
    @echo "✅ Exported to {{ '{{filename}}' }}.pdf"
    @if [ -n "$BA_KS_DATA_ROOT" ] && [ -d "$BA_KS_DATA_ROOT/outbox" ]; then \
        cp publication/main.pdf "$BA_KS_DATA_ROOT/outbox/{{ '{{filename}}' }}.pdf" && \
        echo "✅ Exported to Nextcloud outbox: $BA_KS_DATA_ROOT/outbox/{{ '{{filename}}' }}.pdf"; \
    elif [ -n "$DATA_ROOT" ] && [ -d "$DATA_ROOT/outbox" ]; then \
        cp publication/main.pdf "$DATA_ROOT/outbox/{{ '{{filename}}' }}.pdf" && \
        echo "✅ Exported to Nextcloud outbox: $DATA_ROOT/outbox/{{ '{{filename}}' }}.pdf"; \
    fi

# === Assets & Freeze ===

{% if include_photo_pipeline %}# Reads every image stock declared in .env — one by default, several when
# {{ python_module_name | upper }}_ASSET_SOURCES names them — and builds a
# compressed JPEG cache per stock, pruning output whose source has disappeared.
#
# Photographs are exposure-corrected by fusion (Mertens): a bracket is derived
# from the single frame and merged per pixel, so a subject in shade opens up
# without washing out the sky behind it. Every photograph gets the same
# treatment. Drawn images (maps, plots, screenshots) carry no camera tags and
# are left alone.
#
#   --no-tone   copy the exposure through untouched ({{ python_module_name | upper }}_ASSET_TONE=0 makes it the default)
#   --force     rebuild every file, ignoring the cache
#   --dry-run   report what would happen, write nothing

# Build the compressed image cache from the stocks in .env (NEF→JPG, downscale, expose)
[group('data')]
prepare-assets *flags:
    uv run python scripts/prepare_assets.py {{ '{{flags}}' }}

alias add-asset := add-photo

# Copy a single photo from cache to publication (e.g. just add-photo subdir/IMG_2313.jpg)
[group('data')]
add-photo file:
    @mkdir -p "publication/assets/$(dirname {{ '{{file}}' }})"
{% if not workspace_location_external %}    @cp "_workspace/output/assets/{{ '{{file}}' }}" "publication/assets/{{ '{{file}}' }}"
{% else %}    @test -n "${{ python_module_name | upper }}_WORKSPACE_ROOT" || (echo "{{ python_module_name | upper }}_WORKSPACE_ROOT is empty"; exit 1)
    @cp "${{ python_module_name | upper }}_WORKSPACE_ROOT/output/assets/{{ '{{file}}' }}" "publication/assets/{{ '{{file}}' }}"
{% endif %}    @echo "✓ Copied: publication/assets/{{ '{{file}}' }}"
    @echo "  Typst:  image(\"../../assets/{{ '{{file}}' }}\")"

{% endif %}# Smart-sync pipeline outputs (figures + tables) and refresh committed photos
[group('data')]
freeze:
    uv run python scripts/freeze.py
{% endif %}
# === Cleanup (3 Stages) ===

# 🧹 Stage 1: Clear caches (safe, daily)
[group('plumbing')]
clean:
    @uv run python scripts/clean.py

# 🧼 Stage 2: clean + remove .venv (reinstall required: just setup)
[group('plumbing')]
distclean: clean
    rm -rf .venv
    @echo "✓ .venv removed. Run 'just setup' to reinstall."

# The guards below are the safety net instead of a prompt: nuke stays
# non-interactive so it can run unattended, but it refuses to delete an
# unset, root, HOME or missing workspace path.
# ☢️  Stage 3: distclean + Workspace + Build artifacts (Factory Reset)
[group('plumbing')]
nuke: distclean
{% if not workspace_location_external %}    rm -rf _workspace/*
    @mkdir -p _workspace/output/figures _workspace/output/tables{% if include_typst %} _workspace/output/assets{% endif %}
{% else %}    @test -n "${{ python_module_name | upper }}_WORKSPACE_ROOT" || (echo "{{ python_module_name | upper }}_WORKSPACE_ROOT is empty"; exit 1)
    @test "${{ python_module_name | upper }}_WORKSPACE_ROOT" != "/" || (echo "Refusing to clean /"; exit 1)
    @test "${{ python_module_name | upper }}_WORKSPACE_ROOT" != "$HOME" || (echo "Refusing to clean HOME"; exit 1)
    @test "${{ python_module_name | upper }}_WORKSPACE_ROOT" != "${HOME}/data" || (echo "Refusing to clean ${HOME}/data"; exit 1)
    @test -d "${{ python_module_name | upper }}_WORKSPACE_ROOT" || (echo "Workspace not found"; exit 1)
    rm -rf "{{ '${' }}{{ python_module_name | upper }}_WORKSPACE_ROOT:?}"/*
    @echo "✓ Workspace cleaned."
{% endif %}    @echo "✓ Factory Reset. Run 'just setup' to start fresh."
